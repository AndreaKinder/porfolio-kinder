---
import HerderLink from "./herderLink.astro";
import SliderTheme from "./sliderTheme.astro";
import LogoMark from "./LogoMark.astro";
import "../styles/styles.css";

interface Props {
    lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const isEn = lang === "en";
const base = isEn ? "/en" : "";

const navPlanets = isEn
    ? [
          { id: "inicio", sectionId: "inicio", label: "Home", href: `${base}/#inicio` },
          { id: "sobre-mi", sectionId: "sobre-mi", label: "About", href: `${base}/#sobre-mi` },
          { id: "experiencia", sectionId: "experiencia", label: "Experience", href: `${base}/#experiencia` },
          { id: "proyectos-apps", sectionId: "projects", label: "Projects", href: `${base}/#projects` },
          { id: "habilidades", sectionId: "habilidades", label: "Stack", href: `${base}/#habilidades` },
          { id: "educacion", sectionId: "educacion", label: "Education", href: `${base}/#educacion` },
          { id: "blog", sectionId: "blog", label: "Blog", href: `${base}/#blog` },
          { id: "contacto", sectionId: "contact", label: "Contact", href: `${base}/#contact` },
      ]
    : [
          { id: "inicio", sectionId: "inicio", label: "Inicio", href: "/#inicio" },
          { id: "sobre-mi", sectionId: "sobre-mi", label: "Sobre mí", href: "/#sobre-mi" },
          { id: "experiencia", sectionId: "experiencia", label: "Experiencia", href: "/#experiencia" },
          { id: "proyectos-apps", sectionId: "projects", label: "Proyectos", href: "/#projects" },
          { id: "habilidades", sectionId: "habilidades", label: "Stack", href: "/#habilidades" },
          { id: "educacion", sectionId: "educacion", label: "Formación", href: "/#educacion" },
          { id: "blog", sectionId: "blog", label: "Blog", href: "/#blog" },
          { id: "contacto", sectionId: "contact", label: "Contacto", href: "/#contact" },
      ];
---

<style>
    .navbar-custom .container-fluid {
        max-width: 1380px;
        padding-left: 1.25rem;
        padding-right: 1.25rem;
    }

    /* Corporate Horizontal Navigation Bar */
    .nav-planets-desktop {
        display: flex;
        align-items: center;
        gap: 0.2rem;
    }

    .nav-planet-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 34px;
        padding: 0 0.78rem;
        font-family: var(--font-body);
        font-size: 0.84rem;
        font-weight: 500;
        color: var(--md-sys-color-on-surface-variant);
        text-decoration: none;
        border-radius: var(--md-sys-shape-corner-small);
        white-space: nowrap;
        transition:
            background-color var(--duration-fast) var(--ease-out),
            color var(--duration-fast) var(--ease-out);
    }

    .nav-planet-link:hover {
        text-decoration: none;
        color: var(--md-sys-color-on-surface);
        background-color: color-mix(in srgb, var(--md-sys-color-on-surface) 6%, transparent);
    }

    /* Active Indicator */
    .nav-planet-link.active-planet {
        background-color: var(--md-sys-color-primary);
        color: var(--md-sys-color-on-primary);
        font-weight: 600;
    }

    /* Navigation Drawer Items */
    .offcanvas .nav-link {
        color: var(--md-sys-color-on-surface-variant);
        font-family: var(--font-mono);
        font-size: 0.9375rem;
        font-weight: 500;
        height: 48px;
        padding: 0 1rem;
        border-radius: var(--md-sys-shape-corner-small);
        text-decoration: none;
        display: flex;
        align-items: center;
        transition:
            background-color var(--duration-fast) var(--ease-out),
            color var(--duration-fast) var(--ease-out);
    }

    .offcanvas .nav-link:hover {
        text-decoration: none;
        background-color: color-mix(in srgb, var(--md-sys-color-on-surface) 8%, transparent);
        color: var(--md-sys-color-on-surface);
    }

    .offcanvas .nav-link.active-planet {
        background-color: var(--md-sys-color-primary);
        color: var(--md-sys-color-on-primary);
        font-weight: 600;
    }

    @media (max-width: 1220px) {
        .nav-planets-desktop {
            display: none;
        }
        .navbar-brand {
            font-size: 1.05rem;
        }
    }

    @media (max-width: 480px) {
        .navbar-custom .container-fluid {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }
        .navbar-custom :global(.brand-wordmark-sub) {
            display: none;
        }
        .navbar-custom :global(.brand-wordmark-title) {
            font-size: 0.98rem;
        }
    }

    @media (min-width: 1221px) {
        .navbar-toggler {
            display: none !important;
        }
    }
</style>

<nav class="navbar-custom" id="navbar" aria-label="Navegación principal">
    <div class="container-fluid d-flex align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-2">
            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#navbarOffcanvas"
                aria-controls="navbarOffcanvas"
                aria-label={isEn ? "Open menu" : "Abrir menú"}
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <HerderLink class="navbar-brand" href={isEn ? "/en" : "/"} aria-label={isEn ? "AndreaKinder — Home" : "AndreaKinder — Inicio"}>
                <LogoMark size={26} showWordmark showSubtitle />
            </HerderLink>
        </div>

        <div class="nav-planets-desktop" role="navigation" aria-label={isEn ? "Portfolio sections" : "Secciones del portfolio"}>
            {
                navPlanets.map((item, idx) => (
                    <a
                        class={`nav-planet-link ${idx === 0 ? "active-planet" : ""}`}
                        href={item.href}
                        data-cv-station-id={item.id}
                        data-section-id={item.sectionId}
                    >
                        <span>{item.label}</span>
                    </a>
                ))
            }
        </div>

        <div class="d-flex align-items-center">
            <SliderTheme lang={lang} />
        </div>
    </div>
</nav>

<div
    class="offcanvas offcanvas-start"
    tabindex="-1"
    id="navbarOffcanvas"
    aria-labelledby="navbarOffcanvasLabel"
>
    <div class="offcanvas-header">
        <h5 class="navbar-brand mb-0" id="navbarOffcanvasLabel">
            <LogoMark size={26} showWordmark showSubtitle />
        </h5>
        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"
            aria-label={isEn ? "Close" : "Cerrar"}
        ></button>
    </div>
    <div class="offcanvas-body">
        <ul class="navbar-nav gap-1">
            {
                navPlanets.map((item, idx) => (
                    <li class="nav-item">
                        <a
                            class={`nav-link ${idx === 0 ? "active-planet" : ""}`}
                            href={item.href}
                            data-cv-station-id={item.id}
                            data-section-id={item.sectionId}
                        >
                            <span>{item.label}</span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</div>

<script>
    const navbar = document.getElementById('navbar');

    window.addEventListener('scroll', () => {
        if (window.scrollY > 24) {
            navbar?.classList.add('scrolled');
        } else {
            navbar?.classList.remove('scrolled');
        }
    });

    const planetLinks = document.querySelectorAll<HTMLAnchorElement>('[data-cv-station-id]');

    function highlightActivePlanet(stationId: string) {
        planetLinks.forEach((link) => {
            link.classList.toggle('active-planet', link.dataset.cvStationId === stationId);
        });
    }

    window.addEventListener('cvstationchanged', (e: Event) => {
        const custom = e as CustomEvent<{ stationId: string }>;
        if (custom.detail?.stationId) {
            highlightActivePlanet(custom.detail.stationId);
        }
    });

    planetLinks.forEach((link) => {
        link.addEventListener('click', (e) => {
            const isHome =
                window.location.pathname === '/' || window.location.pathname === '/index.html';
            const is3d = document.documentElement.dataset.view !== '2d';
            const stationId = link.dataset.cvStationId;

            if (isHome && is3d && stationId) {
                e.preventDefault();
                highlightActivePlanet(stationId);
                window.dispatchEvent(
                    new CustomEvent('cvstationselect', { detail: { stationId } }),
                );
                history.replaceState(null, '', `#${stationId}`);
            }

            const offcanvasEl = document.getElementById('navbarOffcanvas');
            if (offcanvasEl && offcanvasEl.classList.contains('show')) {
                const closeBtn = offcanvasEl.querySelector<HTMLButtonElement>('.btn-close');
                closeBtn?.click();
            }
        });
    });

    // Scrollspy automático para la vista 2D
    const observedSections = document.querySelectorAll<HTMLElement>('#cv-2d-view section[id]');
    if (observedSections.length > 0 && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
            (entries) => {
                if (document.documentElement.dataset.view === '3d') return;
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const secId = entry.target.id;
                        planetLinks.forEach((link) => {
                            link.classList.toggle('active-planet', link.dataset.sectionId === secId);
                        });
                    }
                });
            },
            { rootMargin: '-32% 0px -55% 0px', threshold: 0 },
        );
        observedSections.forEach((sec) => observer.observe(sec));
    }
</script>
