---
import HerderLink from "./herderLink.astro";
import SliderTheme from "./sliderTheme.astro";
import "../styles/styles.css";
---

<style>
    .navbar-custom {
        padding: 0.75rem 0;
    }

    .navbar-custom .container-fluid {
        max-width: var(--content-wide);
        padding-left: var(--space-sm);
        padding-right: var(--space-sm);
    }

    .nav-links-desktop {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .nav-link-custom {
        font-family: var(--font-pixel);
        font-size: 12px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--color-text-muted);
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: var(--radius-full);
        transition:
            color var(--duration-fast) var(--ease-out),
            background var(--duration-fast) var(--ease-out);
    }

    .nav-link-custom:hover {
        color: var(--color-text);
        background: var(--color-overlay);
    }

    .nav-link-custom.active {
        color: var(--color-accent);
    }

    .nav-blog-btn {
        font-family: var(--font-pixel);
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #ffffff;
        background: var(--color-accent);
        border: 1px solid var(--color-accent);
        border-radius: var(--radius-control);
        padding: 0.45rem 1.125rem;
        cursor: pointer;
        transition:
            background var(--duration-normal) var(--ease-out),
            border-color var(--duration-normal) var(--ease-out),
            color var(--duration-normal) var(--ease-out),
            transform var(--duration-normal) var(--ease-out),
            box-shadow var(--duration-normal) var(--ease-out);
    }

    .nav-blog-btn:hover {
        background: var(--color-surface);
        border-color: var(--color-accent);
        color: var(--color-accent);
        transform: translateY(-1px);
        box-shadow: var(--shadow-sm);
    }

    .offcanvas .nav-link {
        color: var(--color-text);
        font-family: var(--font-pixel);
        font-size: 0.9375rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--color-border);
        text-decoration: none;
        transition: color var(--duration-fast) var(--ease-out);
    }

    .offcanvas .nav-link:hover {
        color: var(--color-accent);
    }

    .offcanvas .nav-link.active {
        color: var(--color-accent);
    }

    @media (max-width: 992px) {
        .nav-links-desktop {
            display: none;
        }
        .navbar-brand {
            font-size: 1.125rem;
        }
    }

    @media (min-width: 992px) {
        .navbar-toggler {
            display: none;
        }
    }
</style>

<nav class="navbar-custom" id="navbar">
    <div class="container-fluid d-flex align-items-center justify-content-between">
        <button
            class="navbar-toggler d-lg-none"
            type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#navbarOffcanvas"
            aria-controls="navbarOffcanvas"
            aria-label="Abrir menu"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <HerderLink class="navbar-brand" href="/">
            <span class="wordmark-icon">k</span>
            ANDREA KINDER
        </HerderLink>

        <div class="nav-links-desktop">
            <HerderLink class="nav-link-custom" href="/">Inicio</HerderLink>
            <HerderLink class="nav-link-custom" href="/#projects">Proyectos</HerderLink>
            <HerderLink class="nav-link-custom" href="/#contact">Contacto</HerderLink>
            <HerderLink class="nav-link-custom" href="/galery-blog">
                <span class="nav-blog-btn">Blog</span>
            </HerderLink>
            <div style="padding: 0.5rem 0.5rem;">
                <SliderTheme />
            </div>
        </div>

        <div class="d-lg-none">
            <SliderTheme />
        </div>

        <div class="offcanvas offcanvas-start" tabindex="-1" id="navbarOffcanvas">
            <div class="offcanvas-header">
                <h5 class="navbar-brand"><span class="wordmark-icon">k</span> ANDREA KINDER</h5>
                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas"
                    aria-label="Cerrar"
                    style="filter: var(--color-text);"
                ></button>
            </div>
            <div class="offcanvas-body">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <HerderLink class="nav-link" href="/">Inicio</HerderLink>
                    </li>
                    <li class="nav-item">
                        <HerderLink class="nav-link" href="/#projects">Proyectos</HerderLink>
                    </li>
                    <li class="nav-item">
                        <HerderLink class="nav-link" href="/#contact">Contacto</HerderLink>
                    </li>
                    <li class="nav-item">
                        <HerderLink class="nav-link" href="/galery-blog">Blog</HerderLink>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<script>
    const navbar = document.getElementById('navbar');

    window.addEventListener('scroll', () => {
        if (window.scrollY > 60) {
            navbar.classList.add('scrolled');
        } else {
            navbar.classList.remove('scrolled');
        }
    });
</script>
