---
import HerderLink from "./herderLink.astro";
import SliderTheme from "./sliderTheme.astro";
import "../styles/styles.css";

const navPlanets = [
    { id: "inicio", label: "Inicio", href: "/#inicio" },
    { id: "sobre-mi", label: "Sobre mí", href: "/#sobre-mi" },
    { id: "experiencia", label: "Experiencia", href: "/#experiencia" },
    { id: "proyectos-apps", label: "Apps", href: "/#projects" },
    { id: "proyectos-linux", label: "Linux", href: "/#projects" },
    { id: "habilidades", label: "Habilidades", href: "/#habilidades" },
    { id: "educacion", label: "Educación", href: "/#educacion" },
    { id: "blog", label: "Blog", href: "/#blog" },
    { id: "contacto", label: "Contacto", href: "/#contact" },
];
---

<style>
    .navbar-custom .container-fluid {
        max-width: 1380px;
        padding-left: 1.25rem;
        padding-right: 1.25rem;
    }

    /* M3 Navigation Bar / Rail Pill Group */
    .nav-planets-desktop {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        background-color: var(--md-sys-color-surface-container-low);
        border: 1px solid var(--md-sys-color-outline-variant);
        border-radius: var(--md-sys-shape-corner-full);
        padding: 0.25rem;
    }

    .nav-planet-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 32px;
        padding: 0 0.85rem;
        font-family: var(--font-pixel);
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--md-sys-color-on-surface-variant);
        text-decoration: none;
        border-radius: var(--md-sys-shape-corner-full);
        white-space: nowrap;
        transition:
            background-color var(--duration-fast) var(--ease-out),
            color var(--duration-fast) var(--ease-out);
    }

    .nav-planet-link:hover {
        text-decoration: none;
        color: var(--md-sys-color-on-surface);
        background-color: color-mix(in srgb, var(--md-sys-color-on-surface) 8%, transparent);
    }

    /* M3 Active Indicator Pill */
    .nav-planet-link.active-planet {
        background-color: var(--color-accent);
        color: #ffffff;
        font-weight: 600;
    }

    /* M3 Navigation Drawer Items */
    .offcanvas .nav-link {
        color: var(--md-sys-color-on-surface-variant);
        font-family: var(--font-pixel);
        font-size: 0.9375rem;
        font-weight: 500;
        height: 48px;
        padding: 0 1rem;
        border-radius: var(--md-sys-shape-corner-full);
        text-decoration: none;
        display: flex;
        align-items: center;
        transition:
            background-color var(--duration-fast) var(--ease-out),
            color var(--duration-fast) var(--ease-out);
    }

    .offcanvas .nav-link:hover {
        text-decoration: none;
        background-color: color-mix(in srgb, var(--md-sys-color-on-surface) 8%, transparent);
        color: var(--md-sys-color-on-surface);
    }

    .offcanvas .nav-link.active-planet {
        background-color: var(--color-accent);
        color: #ffffff;
        font-weight: 600;
    }

    @media (max-width: 1220px) {
        .nav-planets-desktop {
            display: none;
        }
        .navbar-brand {
            font-size: 1.05rem;
        }
    }

    @media (min-width: 1221px) {
        .navbar-toggler {
            display: none !important;
        }
    }
</style>

<nav class="navbar-custom" id="navbar" aria-label="Navegación principal">
    <div class="container-fluid d-flex align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-2">
            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#navbarOffcanvas"
                aria-controls="navbarOffcanvas"
                aria-label="Abrir menú"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <HerderLink class="navbar-brand" href="/">
                <span class="wordmark-icon">k</span>
                Andrea Kinder
            </HerderLink>
        </div>

        <div class="nav-planets-desktop" role="navigation" aria-label="Secciones del portfolio">
            {
                navPlanets.map((item, idx) => (
                    <a
                        class={`nav-planet-link ${idx === 0 ? "active-planet" : ""}`}
                        href={item.href}
                        data-cv-station-id={item.id}
                    >
                        <span>{item.label}</span>
                    </a>
                ))
            }
        </div>

        <div class="d-flex align-items-center">
            <SliderTheme />
        </div>

        <div class="offcanvas offcanvas-start" tabindex="-1" id="navbarOffcanvas">
            <div class="offcanvas-header">
                <h5 class="navbar-brand mb-0"><span class="wordmark-icon">k</span> Andrea Kinder</h5>
                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas"
                    aria-label="Cerrar"
                ></button>
            </div>
            <div class="offcanvas-body">
                <ul class="navbar-nav gap-1">
                    {
                        navPlanets.map((item, idx) => (
                            <li class="nav-item">
                                <a
                                    class={`nav-link ${idx === 0 ? "active-planet" : ""}`}
                                    href={item.href}
                                    data-cv-station-id={item.id}
                                >
                                    <span>{item.label}</span>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</nav>

<script>
    const navbar = document.getElementById('navbar');

    window.addEventListener('scroll', () => {
        if (window.scrollY > 24) {
            navbar?.classList.add('scrolled');
        } else {
            navbar?.classList.remove('scrolled');
        }
    });

    const planetLinks = document.querySelectorAll<HTMLAnchorElement>('[data-cv-station-id]');

    function highlightActivePlanet(stationId: string) {
        planetLinks.forEach((link) => {
            link.classList.toggle('active-planet', link.dataset.cvStationId === stationId);
        });
    }

    window.addEventListener('cvstationchanged', (e: Event) => {
        const custom = e as CustomEvent<{ stationId: string }>;
        if (custom.detail?.stationId) {
            highlightActivePlanet(custom.detail.stationId);
        }
    });

    planetLinks.forEach((link) => {
        link.addEventListener('click', (e) => {
            const isHome =
                window.location.pathname === '/' || window.location.pathname === '/index.html';
            const is3d = document.documentElement.dataset.view !== '2d';
            const stationId = link.dataset.cvStationId;

            if (isHome && is3d && stationId) {
                e.preventDefault();
                highlightActivePlanet(stationId);
                window.dispatchEvent(
                    new CustomEvent('cvstationselect', { detail: { stationId } }),
                );
                history.replaceState(null, '', `#${stationId}`);
            }

            const offcanvasEl = document.getElementById('navbarOffcanvas');
            if (offcanvasEl && offcanvasEl.classList.contains('show')) {
                const closeBtn = offcanvasEl.querySelector<HTMLButtonElement>('.btn-close');
                closeBtn?.click();
            }
        });
    });
</script>
