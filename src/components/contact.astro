---
import "../styles/styles.css";
import { cvPersonalInfo } from "../data/cvData";

interface Props {
    lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const isEn = lang === "en";
---

<div class="mb-4">
    <p class="section-label">{isEn ? "07 — Contact" : "07 — Contacto"}</p>
    <h2 class="mb-2">{isEn ? "Get in touch" : "Hablemos"}</h2>
    <p class="section-desc">
        {
            isEn
                ? "Reach out directly by email, phone, GitHub, or LinkedIn."
                : "Puedes contactar conmigo directamente por correo electrónico, teléfono, GitHub o LinkedIn."
        }
    </p>
</div>

<div class="row g-3">
    <div class="col-12 col-sm-6">
        <a href={cvPersonalInfo.emailHref} class="contact-quick-card">
            <span class="contact-quick-label">{isEn ? "Email" : "Correo electrónico"}</span>
            <strong class="contact-quick-value">{cvPersonalInfo.email}</strong>
        </a>
    </div>
    <div class="col-12 col-sm-6">
        <a href={cvPersonalInfo.phoneHref} class="contact-quick-card">
            <span class="contact-quick-label">{isEn ? "Phone" : "Teléfono"}</span>
            <strong class="contact-quick-value">{cvPersonalInfo.phone}</strong>
        </a>
    </div>
    <div class="col-12 col-sm-6">
        <a
            href={cvPersonalInfo.github}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-quick-card"
        >
            <span class="contact-quick-label">GitHub</span>
            <strong class="contact-quick-value">github.com/AndreaKinder ↗</strong>
        </a>
    </div>
    <div class="col-12 col-sm-6">
        <a
            href={cvPersonalInfo.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-quick-card"
        >
            <span class="contact-quick-label">LinkedIn</span>
            <strong class="contact-quick-value">Andrea Villar Torres ↗</strong>
        </a>
    </div>
</div>

<style>
    .contact-quick-card {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        padding: 1.25rem 1.4rem;
        background-color: var(--md-sys-color-surface-container-low);
        border: 1px solid var(--md-sys-color-outline-variant);
        border-radius: var(--md-sys-shape-corner-medium);
        text-decoration: none;
        height: 100%;
        transition:
            border-color var(--duration-fast) var(--ease-out),
            background-color var(--duration-fast) var(--ease-out);
    }

    a.contact-quick-card:hover {
        text-decoration: none;
        border-color: var(--color-border-hover);
        background-color: var(--md-sys-color-surface-container);
    }

    .contact-quick-label {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--md-sys-color-on-surface-variant);
    }

    .contact-quick-value {
        font-family: var(--font-body);
        font-size: 0.98rem;
        font-weight: 600;
        color: var(--md-sys-color-on-surface);
        word-break: break-word;
    }
</style>
