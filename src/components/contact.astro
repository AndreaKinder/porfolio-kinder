---
import "../styles/styles.css";
---

<script
    type="text/javascript"
    src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"
></script>
<script type="text/javascript">
    (function () {
        emailjs.init({
            publicKey: "hSD1VQPNhVyqiQAxx",
        });
    })();
</script>
<script type="text/javascript">
    window.onload = function () {
        document
            .getElementById("contact-form")
            .addEventListener("submit", function (event) {
                event.preventDefault();
                emailjs
                    .sendForm("service_84t9w75", "template_nfgerqa", this)
                    .then(
                        () => {
                            console.log("SUCCESS!");
                            document.getElementById("contact-form").reset();
                        },
                        (error) => {
                            console.log("FAILED...", error);
                        },
                    );
            });
    };
</script>

<div class="text-center mb-5">
    <p class="section-label">Contacto</p>
    <h2 class="mb-3">Hablemos</h2>
    <p class="section-desc">
        Si tenes un proyecto en mente o simplemente queres saludar,
        no dudes en escribirme.
    </p>
</div>

<form
    id="contact-form"
    style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); box-shadow: var(--shadow-sm);"
>
    <input type="hidden" name="contact_number" />
    <div class="row g-4">
        <div class="col-12 col-md-6">
            <div class="form-group">
                <label class="form-label" for="user_name">Nombre</label>
                <input
                    type="text"
                    class="form-control"
                    id="user_name"
                    name="user_name"
                    placeholder="Tu nombre"
                    required
                />
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="form-group">
                <label class="form-label" for="user_email">Correo Electronico</label>
                <input
                    type="email"
                    class="form-control"
                    id="user_email"
                    name="user_email"
                    placeholder="tu@email.com"
                    required
                />
            </div>
        </div>
        <div class="col-12">
            <div class="form-group">
                <label class="form-label" for="message">Mensaje</label>
                <textarea
                    class="form-control"
                    id="message"
                    name="message"
                    rows="5"
                    placeholder="Contame sobre tu proyecto..."
                    required
                ></textarea>
            </div>
        </div>
        <div class="col-12">
            <button type="submit" class="btn-primary w-100" id="submit-btn">
                Enviar mensaje
            </button>
        </div>
    </div>
</form>

<script>
    const btn = document.getElementById('submit-btn');
    btn.addEventListener('mousedown', () => {
        btn.style.transform = 'scale(0.97)';
    });
    btn.addEventListener('mouseup', () => {
        btn.style.transform = 'scale(1)';
    });
    btn.addEventListener('mouseleave', () => {
        btn.style.transform = 'scale(1)';
    });
</script>
