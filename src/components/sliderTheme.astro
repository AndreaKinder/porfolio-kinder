---
import '../styles/styles.css';

interface Props {
    lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const isEn = lang === "en";
---

<div class="view-theme-controls" role="group" aria-label={isEn ? "Language and theme controls" : "Selector de idioma y tema"}>
    <!-- Language Switcher: ES | EN -->
    <div class="m3-segmented-group lang-mode-switch" role="group" aria-label={isEn ? "Language" : "Idioma"}>
        <a
            href="/"
            class={`m3-seg-btn ${!isEn ? "is-active-lang" : ""}`}
            title="Ver en Español"
            aria-current={!isEn ? "page" : undefined}
        >
            <span>ES</span>
        </a>
        <a
            href="/en"
            class={`m3-seg-btn ${isEn ? "is-active-lang" : ""}`}
            title="View in English"
            aria-current={isEn ? "page" : undefined}
        >
            <span>EN</span>
        </a>
    </div>

    <!-- Segmented Button: Tema Claro / Oscuro -->
    <div class="m3-segmented-group theme-mode-switch" role="group" aria-label={isEn ? "Light or dark theme" : "Tema Claro u Oscuro"}>
        <button
            type="button"
            class="m3-seg-btn"
            data-set-theme="light"
            title={isEn ? "Light theme" : "Tema Claro"}
            aria-label={isEn ? "Light theme" : "Tema Claro"}
        >
            <span aria-hidden="true">☀</span>
            <span class="seg-label-text">{isEn ? "Light" : "Claro"}</span>
        </button>
        <button
            type="button"
            class="m3-seg-btn"
            data-set-theme="dark"
            title={isEn ? "Dark theme" : "Tema Oscuro"}
            aria-label={isEn ? "Dark theme" : "Tema Oscuro"}
        >
            <span aria-hidden="true">☾</span>
            <span class="seg-label-text">{isEn ? "Dark" : "Oscuro"}</span>
        </button>
    </div>
</div>

<style>
    .view-theme-controls {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .m3-segmented-group {
        display: inline-flex;
        align-items: stretch;
        border: 1px solid var(--md-sys-color-outline-variant);
        border-radius: var(--md-sys-shape-corner-small);
        overflow: hidden;
        background-color: var(--md-sys-color-surface-container-low);
        height: 34px;
    }

    .m3-seg-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.3rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--md-sys-color-on-surface-variant);
        background-color: transparent;
        border: none;
        padding: 0 0.7rem;
        cursor: pointer;
        line-height: 1;
        text-decoration: none;
        transition:
            background-color var(--duration-fast) var(--ease-out),
            color var(--duration-fast) var(--ease-out);
    }

    .m3-seg-btn:hover {
        text-decoration: none;
    }

    .m3-seg-btn.is-active-lang {
        background-color: var(--md-sys-color-primary);
        color: var(--md-sys-color-on-primary);
    }

    .m3-seg-btn + .m3-seg-btn {
        border-left: 1px solid var(--md-sys-color-outline-variant);
    }

    .m3-seg-btn:hover {
        background-color: color-mix(in srgb, var(--md-sys-color-on-surface) 8%, transparent);
    }

    :global(html[data-view="3d"]) .m3-seg-btn[data-set-view="3d"],
    :global(html[data-view="2d"]) .m3-seg-btn[data-set-view="2d"],
    :global(html[data-theme="light"]) .m3-seg-btn[data-set-theme="light"],
    :global(html[data-theme="dark"]) .m3-seg-btn[data-set-theme="dark"] {
        background-color: var(--md-sys-color-primary);
        color: var(--md-sys-color-on-primary);
    }

    @media (max-width: 640px) {
        .seg-label-text {
            display: none;
        }
        .m3-seg-btn {
            padding: 0 0.6rem;
        }
    }
</style>

<script>
    function applyTheme(newTheme: 'light' | 'dark') {
        document.documentElement.dataset.theme = newTheme;
        localStorage.setItem('theme', newTheme);
        window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: newTheme } }));
    }

    function applyViewMode(newView: '3d' | '2d') {
        document.documentElement.dataset.view = newView;
        localStorage.setItem('viewMode', newView);
        window.dispatchEvent(new CustomEvent('viewmodechange', { detail: { view: newView } }));

        if (window.location.pathname !== '/' && window.location.pathname !== '/index.html') {
            window.location.href = '/';
        }
    }

    document.querySelectorAll<HTMLButtonElement>('[data-set-theme]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const targetTheme = btn.dataset.setTheme === 'light' ? 'light' : 'dark';
            applyTheme(targetTheme);
        });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-set-view]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const targetView = btn.dataset.setView === '2d' ? '2d' : '3d';
            applyViewMode(targetView);
        });
    });
</script>
