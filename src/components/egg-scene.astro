---
// Escena 3D del huevo-K, portada de ~/Projects/egg3d (Three.js).
// Adaptaciones: fondo transparente (el escenario lo pinta el CSS),
// pausa el render fuera del viewport o con la pestaña oculta,
// respeta prefers-reduced-motion y ofrece un fallback SVG si WebGL falla.
import '../styles/styles.css';
---

<div class="egg-scene">
    <div
        class="egg-canvas"
        id="egg-canvas"
        role="img"
        aria-label="Logo tridimensional interactivo con forma de huevo y una K"
    ></div>
</div>

<script>
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

const mount = document.getElementById('egg-canvas');

if (mount) {
    initEggScene(mount);
}

function initEggScene(mountEl: HTMLElement) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let renderer: THREE.WebGLRenderer;
    try {
        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    } catch {
        renderStaticFallback(mountEl);
        return;
    }

    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 100);
    camera.position.set(0, 0, 6.8);

    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    mountEl.appendChild(renderer.domElement);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.055;
    controls.enablePan = false;
    controls.minDistance = 4.4;
    controls.maxDistance = 9;
    controls.minPolarAngle = Math.PI * 0.24;
    controls.maxPolarAngle = Math.PI * 0.76;
    controls.autoRotate = !reduceMotion;
    controls.autoRotateSpeed = 0.72;

    // En pantallas pequeñas el arrastre secuestraría el scroll de la página:
    // desactivamos los controles y permitimos el scroll vertical sobre el lienzo.
    if (window.matchMedia('(max-width: 767px)').matches) {
        controls.enabled = false;
        renderer.domElement.style.touchAction = 'pan-y';
    }

    scene.add(new THREE.HemisphereLight('#fffaff', '#cba6c1', 2.3));
    const keyLight = new THREE.DirectionalLight('#ffffff', 3.2);
    keyLight.position.set(-3, 4, 6);
    scene.add(keyLight);
    const pinkLight = new THREE.PointLight('#ff70bb', 28, 8);
    pinkLight.position.set(2, -1, 3);
    scene.add(pinkLight);

    const logo = new THREE.Group();
    logo.rotation.z = -0.045;
    scene.add(logo);

    const EGG_HEIGHT = 1.5;
    const EGG_RADIUS = 1.2;

    function eggPoint(latitude: number, longitude: number, offset = 0): THREE.Vector3 {
        const t = Math.sin(latitude);
        const radius = EGG_RADIUS * Math.cos(latitude) * (1 - 0.19 * t);
        const r = radius + offset;
        return new THREE.Vector3(r * Math.cos(longitude), EGG_HEIGHT * t, r * Math.sin(longitude));
    }

    function makeEggGeometry(): THREE.BufferGeometry {
        const rows = 72;
        const columns = 96;
        const positions: number[] = [];
        const indices: number[] = [];
        for (let row = 0; row <= rows; row++) {
            const latitude = -Math.PI / 2 + (Math.PI * row) / rows;
            for (let column = 0; column <= columns; column++) {
                positions.push(...eggPoint(latitude, (Math.PI * 2 * column) / columns).toArray());
            }
        }
        for (let row = 0; row < rows; row++) {
            for (let column = 0; column < columns; column++) {
                const a = row * (columns + 1) + column;
                const b = a + columns + 1;
                indices.push(a, b, a + 1, b, b + 1, a + 1);
            }
        }
        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
        geometry.setIndex(indices);
        geometry.computeVertexNormals();
        return geometry;
    }

    const shell = new THREE.Mesh(
        makeEggGeometry(),
        new THREE.MeshPhysicalMaterial({
            color: '#ffdff0',
            roughness: 0.34,
            metalness: 0.04,
            clearcoat: 0.48,
            clearcoatRoughness: 0.3,
            transparent: true,
            opacity: 0.38,
            depthWrite: false,
            side: THREE.DoubleSide,
        }),
    );
    logo.add(shell);

    function addGridLine(
        points: THREE.Vector3[],
        color: string,
        opacity: number,
        radius = 0.006,
    ) {
        const curve = new THREE.CatmullRomCurve3(points);
        const line = new THREE.Mesh(
            new THREE.TubeGeometry(curve, Math.max(points.length * 2, 48), radius, 4, false),
            new THREE.MeshBasicMaterial({ color, transparent: true, opacity }),
        );
        logo.add(line);
    }

    // Paralelos y meridianos: la cáscara se lee como el wireframe impreso de la referencia.
    for (let index = -7; index <= 7; index++) {
        if (index === 0) continue;
        const latitude = index * 0.176;
        const points = Array.from({ length: 97 }, (_, i) =>
            eggPoint(latitude, (Math.PI * 2 * i) / 96, 0.008),
        );
        addGridLine(
            points,
            index % 2 ? '#ea54a8' : '#bd75b4',
            index % 2 ? 0.7 : 0.5,
            index % 3 === 0 ? 0.007 : 0.0045,
        );
    }
    for (let index = 0; index < 20; index++) {
        const longitude = (Math.PI * 2 * index) / 20;
        const points = Array.from({ length: 65 }, (_, i) =>
            eggPoint(-Math.PI / 2 + (Math.PI * i) / 64, longitude, 0.009),
        );
        addGridLine(
            points,
            index % 2 ? '#e755a6' : '#bd75b4',
            index % 2 ? 0.62 : 0.46,
            0.0045,
        );
    }

    // Motas finas que evocan la textura punteada serigrafiada de la marca original.
    const speckPositions: number[] = [];
    const speckColors: number[] = [];
    const speckPalette = [
        new THREE.Color('#ed43a2'),
        new THREE.Color('#a862a1'),
        new THREE.Color('#f58cbd'),
    ];
    let seed = 17;
    const random = () => {
        seed = (seed * 16807) % 2147483647;
        return (seed - 1) / 2147483646;
    };
    for (let i = 0; i < 520; i++) {
        const latitude = (random() - 0.5) * Math.PI * 0.84;
        const longitude = random() * Math.PI * 2;
        const point = eggPoint(latitude, longitude, 0.018);
        if (Math.sin(longitude) > 0.35 && Math.abs(point.x) < 0.82 && Math.abs(point.y) < 0.83)
            continue;
        speckPositions.push(point.x, point.y, point.z);
        const speckColor = speckPalette[Math.floor(random() * speckPalette.length)];
        if (speckColor) speckColors.push(...speckColor.toArray());
    }
    const specksGeometry = new THREE.BufferGeometry();
    specksGeometry.setAttribute('position', new THREE.Float32BufferAttribute(speckPositions, 3));
    specksGeometry.setAttribute('color', new THREE.Float32BufferAttribute(speckColors, 3));
    const specks = new THREE.Points(
        specksGeometry,
        new THREE.PointsMaterial({
            size: 0.014,
            vertexColors: true,
            transparent: true,
            opacity: 0.7,
            sizeAttenuation: true,
        }),
    );
    logo.add(specks);

    // Silueta nítida: la marca sigue siendo gráfica mientras la cáscara gira en 3D.
    const outlinePoints: THREE.Vector3[] = [];
    for (let i = 0; i <= 100; i++) {
        const latitude = -Math.PI / 2 + (Math.PI * i) / 100;
        const radius = EGG_RADIUS * Math.cos(latitude) * (1 - 0.19 * Math.sin(latitude));
        outlinePoints.push(new THREE.Vector3(radius, EGG_HEIGHT * Math.sin(latitude), 0.015));
    }
    for (let i = 100; i >= 0; i--) {
        const latitude = -Math.PI / 2 + (Math.PI * i) / 100;
        const radius = EGG_RADIUS * Math.cos(latitude) * (1 - 0.19 * Math.sin(latitude));
        outlinePoints.push(new THREE.Vector3(-radius, EGG_HEIGHT * Math.sin(latitude), 0.015));
    }
    const outline = new THREE.LineLoop(
        new THREE.BufferGeometry().setFromPoints(outlinePoints),
        new THREE.LineBasicMaterial({ color: '#704579', linewidth: 2 }),
    );
    logo.add(outline);

    function makeKShape(): THREE.Shape {
        const shape = new THREE.Shape();
        const pixel = 0.075;
        const corners = [
            [-0.56, -0.68], [-0.16, -0.68], [-0.16, -0.22], [0.31, -0.68],
            [0.78, -0.68], [0.16, 0], [0.77, 0.68], [0.29, 0.68],
            [-0.16, 0.22], [-0.16, 0.68], [-0.56, 0.68],
        ].map(([x, y]) => [Math.round(x / pixel), Math.round(y / pixel)]);
        const start = corners[0];
        if (start) shape.moveTo(start[0] * pixel, start[1] * pixel);
        for (let segment = 0; segment < corners.length; segment++) {
            const corner = corners[segment];
            const next = corners[(segment + 1) % corners.length];
            if (!corner || !next) continue;
            let [x, y] = corner;
            const [endX, endY] = next;
            const dx = Math.abs(endX - x);
            const dy = Math.abs(endY - y);
            const stepX = x < endX ? 1 : -1;
            const stepY = y < endY ? 1 : -1;
            let error = dx - dy;
            while (x !== endX || y !== endY) {
                const doubledError = 2 * error;
                const moveX = doubledError > -dy;
                const moveY = doubledError < dx;
                if (moveX) error -= dy;
                if (moveY) error += dx;
                if (moveX) { x += stepX; shape.lineTo(x * pixel, y * pixel); }
                if (moveY) { y += stepY; shape.lineTo(x * pixel, y * pixel); }
            }
        }
        shape.closePath();
        return shape;
    }

    const kShape = makeKShape();
    const backingGeometry = new THREE.ExtrudeGeometry(kShape, {
        depth: 0.13,
        bevelEnabled: false,
        curveSegments: 1,
    });
    backingGeometry.translate(0, 0, 1.28);
    const backing = new THREE.Mesh(
        backingGeometry,
        new THREE.MeshStandardMaterial({ color: '#e63d9b', roughness: 0.38, metalness: 0.06 }),
    );
    backing.scale.setScalar(1.11);
    logo.add(backing);

    const faceGeometry = new THREE.ExtrudeGeometry(kShape, {
        depth: 0.15,
        bevelEnabled: false,
        curveSegments: 1,
    });
    faceGeometry.translate(0, 0, 1.25);
    const face = new THREE.Mesh(
        faceGeometry,
        new THREE.MeshStandardMaterial({
            color: '#ffffff',
            roughness: 0.31,
            metalness: 0.02,
            emissive: '#fff7fc',
            emissiveIntensity: 0.12,
        }),
    );
    face.position.z = 0.25;
    logo.add(face);

    const resize = () => {
        const width = mountEl.clientWidth;
        const height = mountEl.clientHeight;
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height, false);
    };
    new ResizeObserver(resize).observe(mountEl);
    resize();

    const clock = new THREE.Clock();
    let rafId = 0;
    let inView = true;

    function animate() {
        rafId = requestAnimationFrame(animate);
        const time = clock.getElapsedTime();
        if (!reduceMotion) logo.position.y = Math.sin(time * 1.15) * 0.035;
        controls.update();
        renderer.render(scene, camera);
    }

    function sync() {
        const shouldRun = inView && !document.hidden;
        if (shouldRun && rafId === 0) {
            rafId = requestAnimationFrame(animate);
        } else if (!shouldRun && rafId !== 0) {
            cancelAnimationFrame(rafId);
            rafId = 0;
        }
    }

    new IntersectionObserver(([entry]) => {
        inView = entry?.isIntersecting ?? true;
        sync();
    }).observe(mountEl);

    document.addEventListener('visibilitychange', sync);

    sync();
}

// Fallback sin WebGL: silueta del huevo con la K, misma paleta serigrafiada.
function renderStaticFallback(mountEl: HTMLElement) {
    mountEl.classList.add('egg-fallback');
    mountEl.innerHTML = `
        <svg viewBox="0 0 180 230" width="60%" role="img" aria-label="Huevo con la letra K">
            <ellipse cx="90" cy="125" rx="74" ry="98" fill="none" stroke="#704579" stroke-width="3"/>
            <path d="M90 27 C 62 45 34 90 34 132 C 34 180 58 215 90 223 C 122 215 146 180 146 132 C 146 90 118 45 90 27 Z"
                fill="none" stroke="#ea54a8" stroke-width="1.5" opacity="0.6"/>
            <path d="M70 78 v92 M70 124 l40 -46 M78 122 l34 48" fill="none"
                stroke="#e63d9b" stroke-width="14" stroke-linecap="square"/>
        </svg>`;
}
</script>
