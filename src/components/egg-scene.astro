---
// Planetario 3D de Huevos (Orrery serigrafiado estilo egg3d):
// - Sol Central: El Huevo con la K pixelada extruida (en anverso y reverso),
//   cáscara física translúcida, paralelos/meridianos tubulares y 520 motas.
// - 8 Huevos-Planeta persistentes en órbitas elípticas inclinadas, cada uno
//   con su propia arquitectura astronómica (anillos de Saturno, esfera armilar,
//   bandas gaseosas, órbita molecular, meridianos editoriales, etc.).
// - Huevos-Luna reales que orbitan alrededor del Huevo-Planeta activo.
import "../styles/styles.css";
import { cvStations, type CvStation, type CvSubItem } from "../data/cvData";

interface BlogMarkdownModule {
    url?: string;
    frontmatter?: {
        title?: string;
        author?: string;
        description?: string;
    };
}

const blogModules = import.meta.glob<BlogMarkdownModule>("../pages/blog/*.md", { eager: true });
const dynamicBlogItems: CvSubItem[] = Object.entries(blogModules).map(([path, mod]) => {
    const slug = path.split("/").pop()?.replace(/\.md$/, "") ?? "articulo";
    const url = mod.url ?? `/blog/${slug}`;
    const title = mod.frontmatter?.title ?? slug;
    const author = mod.frontmatter?.author ?? "Andrea Villar";
    const description =
        mod.frontmatter?.description ?? "Artículo publicado en el blog de Andrea Villar.";
    return {
        id: `blog-${slug}`,
        title,
        subtitle: `Por ${author} · Artículo del Blog`,
        period: "Publicado",
        description,
        tags: ["Blog", "Artículo", "Andrea Villar"],
        href: url,
        linkLabel: "Leer artículo",
    };
});

dynamicBlogItems.push({
    id: "galeria-blog-completa",
    title: "Galería Completa del Blog",
    subtitle: "Todos los artículos y reflexiones",
    period: `${dynamicBlogItems.length} artículos`,
    description:
        "Explora el índice completo del blog con todos los artículos publicados sobre desarrollo, inteligencia artificial, hackathons y software libre.",
    tags: ["Blog", "Índice", "Lectura"],
    href: "/galery-blog",
    linkLabel: "Abrir galería del blog",
});

const stationsWithBlog: CvStation[] = cvStations.map((st) =>
    st.id === "blog" && dynamicBlogItems.length > 1
        ? {
              ...st,
              period: `${dynamicBlogItems.length - 1} artículos publicados`,
              items: dynamicBlogItems,
          }
        : st,
);
---

<div class="cv-3d-stage" id="cv-3d-view">
    <script
        is:inline
        type="application/json"
        id="cv-stations-json"
        set:html={JSON.stringify(stationsWithBlog)}
    />

    <!-- Lienzo 3D a pantalla completa: Planetario de Huevos con el Huevo-K central -->
    <div
        id="egg-cv-canvas"
        class="cv-canvas-mount"
        role="region"
        aria-label="Planetario 3D interactivo con el Huevo-K central y 8 huevos-planeta en órbita"
    ></div>

    <!-- Panel lateral editorial Material 3 -->
    <aside class="cv-hud-panel" id="cv-hud-panel" aria-live="polite">
        <div class="cv-panel-top-row">
            <p class="eyebrow mb-0" id="hud-eyebrow">
                Inicio
            </p>
            <span class="cv-period-badge" id="hud-period">2 años de experiencia</span>
        </div>

        <div class="cv-panel-header">
            <h1 class="cv-station-title" id="hud-title">
                Andrea Villar Torres
            </h1>
            <p class="cv-org-line" id="hud-org">
                Desarrolladora Full Stack · Web & Mobile
            </p>
            <p class="cv-station-summary" id="hud-summary">
                {stationsWithBlog[0]?.summary}
            </p>
        </div>

        <!-- Selector de Huevos-Luna del Huevo-Planeta actual -->
        <div class="cv-subnodes-bar">
            <div class="cv-subnodes-header">
                <span class="cv-subnodes-label">Satélites de esta sección</span>
                <div class="cv-subnodes-arrows">
                    <button
                        type="button"
                        id="btn-prev-item"
                        class="cv-mini-btn"
                        title="Satélite anterior (Flecha izquierda)"
                        aria-label="Satélite anterior"
                    >
                        ◀
                    </button>
                    <span id="hud-item-counter" class="cv-item-counter">1 / 3</span>
                    <button
                        type="button"
                        id="btn-next-item"
                        class="cv-mini-btn"
                        title="Siguiente satélite (Flecha derecha)"
                        aria-label="Siguiente satélite"
                    >
                        ▶
                    </button>
                </div>
            </div>
            <div class="cv-subnode-chips" id="hud-subnode-chips"></div>
        </div>

        <!-- Tarjeta de detalle del Huevo-Luna activo -->
        <div class="cv-detail-card" id="hud-detail-card">
            <div class="d-flex align-items-start justify-content-between gap-2 mb-1">
                <div>
                    <h2 class="cv-detail-title" id="hud-detail-title">Resumen Ejecutivo</h2>
                    <p class="cv-detail-subtitle" id="hud-detail-subtitle">
                        Full Stack Web, Mobile & Cloud
                    </p>
                </div>
                <span class="cv-detail-period" id="hud-detail-period"></span>
            </div>
            <p class="cv-detail-desc" id="hud-detail-desc"></p>
            <div class="cv-detail-footer">
                <div class="cv-detail-tags" id="hud-detail-tags"></div>
                <a
                    id="hud-detail-link"
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="cv-detail-link d-none"
                >
                    <span id="hud-detail-link-text">Ver proyecto</span>
                    <span>↗</span>
                </a>
            </div>
        </div>
    </aside>

    <!-- Etiqueta flotante de precisión al pasar el cursor sobre cualquier Huevo-Planeta o Huevo-Luna -->
    <div id="cv-hover-tooltip" class="cv-hover-tooltip" aria-hidden="true"></div>

    <!-- Barra inferior flotante refinada -->
    <footer class="cv-hud-bottom">
        <div class="cv-bottom-controls">
            <button
                type="button"
                id="btn-prev-station"
                class="cv-hud-btn"
                aria-label="Planeta anterior"
            >
                <span>◀</span>
                <span class="d-none d-sm-inline">Anterior</span>
            </button>

            <div class="cv-progress-display" aria-hidden="true">
                <div class="cv-progress-track">
                    <div class="cv-progress-fill" id="cv-progress-fill"></div>
                </div>
            </div>

            <button
                type="button"
                id="btn-next-station"
                class="cv-hud-btn cv-hud-btn-primary"
                aria-label="Siguiente planeta"
            >
                <span class="d-none d-sm-inline">Siguiente</span>
                <span>▶</span>
            </button>

            <button
                type="button"
                id="btn-auto-tour"
                class="cv-hud-btn"
                aria-pressed="false"
                title="Activar o pausar órbita automática"
            >
                <span id="auto-tour-icon">▶</span>
                <span class="d-none d-md-inline" id="auto-tour-label">Auto-Órbita</span>
            </button>

            <button
                type="button"
                id="btn-reset-camera"
                class="cv-hud-btn cv-icon-only"
                title="Centrar planetario"
                aria-label="Centrar planetario"
            >
                ↺
            </button>

            <button
                type="button"
                id="btn-toggle-hud"
                class="cv-hud-btn cv-icon-only"
                aria-pressed="false"
                title="Minimizar o mostrar panel de lectura"
                aria-label="Minimizar o mostrar panel de lectura"
            >
                👁
            </button>
        </div>
    </footer>
</div>

<script>
    import * as THREE from "three";
    import { cvStations, type CvStation } from "../data/cvData";

    const jsonEl = document.getElementById("cv-stations-json");
    let stations: CvStation[] = cvStations;
    if (jsonEl?.textContent) {
        try {
            stations = JSON.parse(jsonEl.textContent) as CvStation[];
        } catch {
            stations = cvStations;
        }
    }

    const mountEl = document.getElementById("egg-cv-canvas");
    if (mountEl) {
        initEggPlanetarium(mountEl, stations);
    }

    function initEggPlanetarium(container: HTMLElement, cvList: CvStation[]) {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        let activeStationIdx = 0;
        let activeItemIdx = 0;
        let autoTour = false;
        let autoTourTimer = 0;

        // Rotación del carrusel planetario para situar siempre el Huevo-Planeta activo
        // en la posición de honor frontal-derecha junto al Huevo-K central
        const SHOWCASE_ANGLE = 0.58; // ~33 grados a la derecha del frente (+Z)
        let targetSystemAngle = 0;
        let currentSystemAngle = 0;

        // Control orbital manual (drag + zoom suave)
        let isDragging = false;
        let dragMoved = false;
        let pointerDownPos = { x: 0, y: 0 };
        let userYaw = 0;
        let userPitch = 0;
        let currentYaw = 0;
        let currentPitch = 0;

        // Referencias del HUD
        const eyebrowEl = document.getElementById("hud-eyebrow");
        const titleEl = document.getElementById("hud-title");
        const periodEl = document.getElementById("hud-period");
        const orgEl = document.getElementById("hud-org");
        const summaryEl = document.getElementById("hud-summary");
        const chipsContainer = document.getElementById("hud-subnode-chips");
        const itemCounterEl = document.getElementById("hud-item-counter");
        const detailTitleEl = document.getElementById("hud-detail-title");
        const detailSubtitleEl = document.getElementById("hud-detail-subtitle");
        const detailPeriodEl = document.getElementById("hud-detail-period");
        const detailDescEl = document.getElementById("hud-detail-desc");
        const detailTagsEl = document.getElementById("hud-detail-tags");
        const detailLinkEl = document.getElementById("hud-detail-link") as HTMLAnchorElement | null;
        const detailLinkTextEl = document.getElementById("hud-detail-link-text");
        const progressFillEl = document.getElementById("cv-progress-fill");
        const hoverTooltipEl = document.getElementById("cv-hover-tooltip");
        const hudPanelEl = document.getElementById("cv-hud-panel");

        function syncHud() {
            const station = cvList[activeStationIdx];
            if (!station) return;

            if (eyebrowEl) {
                eyebrowEl.textContent = station.eyebrow;
            }
            if (titleEl) {
                titleEl.textContent = `${station.title} ${station.titleAccent}`.trim();
            }
            if (periodEl) {
                periodEl.textContent = station.period ?? "";
            }
            if (orgEl) {
                orgEl.innerHTML = `${station.organization ?? ""} ${
                    station.location ? `· <span>${station.location}</span>` : ""
                }`;
            }
            if (summaryEl) {
                summaryEl.textContent = station.summary;
            }

            window.dispatchEvent(
                new CustomEvent("cvstationchanged", { detail: { stationId: station.id } }),
            );

            if (chipsContainer) {
                chipsContainer.innerHTML = "";
                station.items.forEach((item, idx) => {
                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.className = `cv-subnode-chip ${idx === activeItemIdx ? "active" : ""}`;
                    btn.textContent = item.title;
                    btn.addEventListener("click", () => {
                        selectStationAndItem(activeStationIdx, idx);
                    });
                    chipsContainer.appendChild(btn);
                });
            }

            const activeItem = station.items[activeItemIdx] ?? station.items[0];
            if (itemCounterEl) {
                itemCounterEl.textContent = `${activeItemIdx + 1} / ${station.items.length}`;
            }

            if (activeItem) {
                if (detailTitleEl) detailTitleEl.textContent = activeItem.title;
                if (detailSubtitleEl) detailSubtitleEl.textContent = activeItem.subtitle ?? "";
                if (detailPeriodEl) {
                    detailPeriodEl.textContent = activeItem.period ?? "";
                    detailPeriodEl.style.display = activeItem.period ? "inline-block" : "none";
                }
                if (detailDescEl) detailDescEl.textContent = activeItem.description;
                if (detailTagsEl) {
                    detailTagsEl.innerHTML = activeItem.tags
                        .map((t) => `<span class="cv-tag-badge">${t}</span>`)
                        .join("");
                }
                if (detailLinkEl && detailLinkTextEl) {
                    if (activeItem.href) {
                        detailLinkEl.href = activeItem.href;
                        const isInternal = activeItem.href.startsWith("/");
                        detailLinkEl.target = isInternal ? "_self" : "_blank";
                        detailLinkTextEl.textContent = activeItem.linkLabel ?? "Abrir enlace";
                        detailLinkEl.classList.remove("d-none");
                    } else {
                        detailLinkEl.classList.add("d-none");
                    }
                }
            }

            const ratio =
                cvList.length > 1 ? (activeStationIdx / (cvList.length - 1)) * 100 : 100;
            if (progressFillEl) {
                progressFillEl.style.width = `${ratio}%`;
            }
        }

        function setOrbitTargetForStation(stationIdx: number) {
            const total = cvList.length;
            const planetBaseAngle = (stationIdx / total) * Math.PI * 2;
            const desiredAngle = SHOWCASE_ANGLE - planetBaseAngle;
            let diff = desiredAngle - targetSystemAngle;
            diff = Math.atan2(Math.sin(diff), Math.cos(diff));
            targetSystemAngle += diff;
        }

        function selectStationAndItem(stationIdx: number, itemIdx = 0) {
            const total = cvList.length;
            const wrappedStation = ((stationIdx % total) + total) % total;
            const station = cvList[wrappedStation];
            const clampedItem = station
                ? Math.max(0, Math.min(station.items.length - 1, itemIdx))
                : 0;

            const stationChanged = activeStationIdx !== wrappedStation;
            activeStationIdx = wrappedStation;
            activeItemIdx = clampedItem;

            setOrbitTargetForStation(wrappedStation);
            if (stationChanged) {
                userYaw = 0;
                userPitch = 0;
            }

            syncHud();
            rebuildMoonSatellites();
            refreshPlanetBadges();
        }

        document.getElementById("btn-prev-station")?.addEventListener("click", () => {
            selectStationAndItem(activeStationIdx - 1, 0);
        });

        document.getElementById("btn-next-station")?.addEventListener("click", () => {
            selectStationAndItem(activeStationIdx + 1, 0);
        });

        document.getElementById("btn-prev-item")?.addEventListener("click", () => {
            const station = cvList[activeStationIdx];
            if (!station) return;
            const nextIdx = (activeItemIdx - 1 + station.items.length) % station.items.length;
            selectStationAndItem(activeStationIdx, nextIdx);
        });

        document.getElementById("btn-next-item")?.addEventListener("click", () => {
            const station = cvList[activeStationIdx];
            if (!station) return;
            const nextIdx = (activeItemIdx + 1) % station.items.length;
            selectStationAndItem(activeStationIdx, nextIdx);
        });

        document.getElementById("btn-reset-camera")?.addEventListener("click", () => {
            userYaw = 0;
            userPitch = 0;
        });

        const btnAutoTour = document.getElementById("btn-auto-tour");
        const autoTourIcon = document.getElementById("auto-tour-icon");
        const autoTourLabel = document.getElementById("auto-tour-label");
        btnAutoTour?.addEventListener("click", () => {
            autoTour = !autoTour;
            autoTourTimer = 0;
            btnAutoTour.setAttribute("aria-pressed", String(autoTour));
            btnAutoTour.classList.toggle("active", autoTour);
            if (autoTourIcon) autoTourIcon.textContent = autoTour ? "Ⅱ" : "▶";
            if (autoTourLabel) autoTourLabel.textContent = autoTour ? "Pausar" : "Auto-Órbita";
        });

        const btnToggleHud = document.getElementById("btn-toggle-hud");
        btnToggleHud?.addEventListener("click", () => {
            if (!hudPanelEl) return;
            const hidden = hudPanelEl.classList.toggle("cv-panel-minimized");
            btnToggleHud.setAttribute("aria-pressed", String(hidden));
        });

        window.addEventListener("cvstationselect", (e: Event) => {
            const custom = e as CustomEvent<{ stationIdx?: number; stationId?: string }>;
            if (typeof custom.detail?.stationId === "string") {
                const foundIdx = cvList.findIndex((s) => s.id === custom.detail.stationId);
                if (foundIdx !== -1) {
                    selectStationAndItem(foundIdx, 0);
                    return;
                }
            }
            if (typeof custom.detail?.stationIdx === "number") {
                selectStationAndItem(custom.detail.stationIdx, 0);
            }
        });

        const initialHash = window.location.hash.replace("#", "");
        if (initialHash) {
            const hashMap: Record<string, string> = {
                perfil: "perfil",
                experiencia: "experiencia",
                projects: "proyectos-apps",
                habilidades: "habilidades",
                educacion: "educacion",
                blog: "blog",
                contact: "contacto",
            };
            const targetId = hashMap[initialHash] ?? initialHash;
            const initialIdx = cvList.findIndex((s) => s.id === targetId);
            if (initialIdx !== -1) {
                activeStationIdx = initialIdx;
            }
        }
        setOrbitTargetForStation(activeStationIdx);
        currentSystemAngle = targetSystemAngle;
        syncHud();

        // -----------------------------------------------------------------
        // CONFIGURACIÓN DE WEBGL / THREE.JS
        // -----------------------------------------------------------------
        let renderer: THREE.WebGLRenderer;
        try {
            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        } catch {
            container.innerHTML = `
                <div class="cv-webgl-fallback">
                    <p>WebGL no está disponible en este navegador. Cambia a la <strong>Vista 2D</strong> arriba a la derecha.</p>
                </div>`;
            return;
        }

        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.15;
        container.appendChild(renderer.domElement);

        const scene = new THREE.Scene();

        // Cámara con perspectiva elevada apuntando al centro del planetario
        const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 120);
        camera.position.set(0, 1.25, 8.6);
        camera.lookAt(0, -0.05, 0);

        const hemiLight = new THREE.HemisphereLight("#fffaff", "#cba6c1", 2.35);
        scene.add(hemiLight);

        const keyLight = new THREE.DirectionalLight("#ffffff", 3.2);
        keyLight.position.set(-4, 6, 8);
        scene.add(keyLight);

        const pinkLight = new THREE.PointLight("#ff70bb", 32, 16);
        pinkLight.position.set(3, -1, 5);
        scene.add(pinkLight);

        const rimLight = new THREE.DirectionalLight("#bd75b4", 1.6);
        rimLight.position.set(5, -3, -6);
        scene.add(rimLight);

        // Raíz del Planetario
        const planetariumRoot = new THREE.Group();
        scene.add(planetariumRoot);

        // -----------------------------------------------------------------
        // MATEMÁTICA DEL HUEVO CANÓNICO (egg3d)
        // -----------------------------------------------------------------
        const EGG_HEIGHT = 1.42;
        const EGG_RADIUS = 1.14;

        function eggPoint(
            latitude: number,
            longitude: number,
            offset = 0,
            scaleH = EGG_HEIGHT,
            scaleR = EGG_RADIUS,
        ): THREE.Vector3 {
            const t = Math.sin(latitude);
            const radius = scaleR * Math.cos(latitude) * (1 - 0.19 * t);
            const r = radius + offset;
            return new THREE.Vector3(
                r * Math.cos(longitude),
                scaleH * t,
                r * Math.sin(longitude),
            );
        }

        function buildEggGeometry(rows = 64, columns = 84): THREE.BufferGeometry {
            const positions: number[] = [];
            const indices: number[] = [];
            for (let row = 0; row <= rows; row++) {
                const latitude = -Math.PI / 2 + (Math.PI * row) / rows;
                for (let column = 0; column <= columns; column++) {
                    positions.push(
                        ...eggPoint(latitude, (Math.PI * 2 * column) / columns).toArray(),
                    );
                }
            }
            for (let row = 0; row < rows; row++) {
                for (let column = 0; column < columns; column++) {
                    const a = row * (columns + 1) + column;
                    const b = a + columns + 1;
                    indices.push(a, b, a + 1, b, b + 1, a + 1);
                }
            }
            const geo = new THREE.BufferGeometry();
            geo.setAttribute("position", new THREE.Float32BufferAttribute(positions, 3));
            geo.setIndex(indices);
            geo.computeVertexNormals();
            return geo;
        }

        const sharedSunEggGeo = buildEggGeometry(68, 90);
        const sharedPlanetEggGeo = buildEggGeometry(44, 60);
        const sharedMoonEggGeo = buildEggGeometry(28, 36);

        // -----------------------------------------------------------------
        // 1. EL SOL CENTRAL: HUEVO CON LA K (FIEL A EGG3D)
        // -----------------------------------------------------------------
        const sunEggGroup = new THREE.Group();
        sunEggGroup.rotation.z = -0.045;
        planetariumRoot.add(sunEggGroup);

        const sunShellMat = new THREE.MeshPhysicalMaterial({
            color: "#ffdff0",
            roughness: 0.34,
            metalness: 0.04,
            clearcoat: 0.48,
            clearcoatRoughness: 0.3,
            transparent: true,
            opacity: 0.38,
            depthWrite: false,
            side: THREE.DoubleSide,
        });
        sunEggGroup.add(new THREE.Mesh(sharedSunEggGeo, sunShellMat));

        function addTubeLine(
            parent: THREE.Group,
            points: THREE.Vector3[],
            color: string,
            opacity: number,
            radius = 0.0055,
        ) {
            const curve = new THREE.CatmullRomCurve3(points);
            const mesh = new THREE.Mesh(
                new THREE.TubeGeometry(curve, Math.max(points.length * 2, 40), radius, 4, false),
                new THREE.MeshBasicMaterial({ color, transparent: true, opacity }),
            );
            parent.add(mesh);
        }

        // Paralelos y meridianos serigrafiados del Huevo-K central
        for (let index = -7; index <= 7; index++) {
            if (index === 0) continue;
            const latitude = index * 0.176;
            const points = Array.from({ length: 85 }, (_, i) =>
                eggPoint(latitude, (Math.PI * 2 * i) / 84, 0.008),
            );
            addTubeLine(
                sunEggGroup,
                points,
                index % 2 ? "#ea54a8" : "#bd75b4",
                index % 2 ? 0.72 : 0.5,
                index % 3 === 0 ? 0.0065 : 0.0042,
            );
        }
        for (let index = 0; index < 20; index++) {
            const longitude = (Math.PI * 2 * index) / 20;
            const points = Array.from({ length: 57 }, (_, i) =>
                eggPoint(-Math.PI / 2 + (Math.PI * i) / 56, longitude, 0.009),
            );
            addTubeLine(
                sunEggGroup,
                points,
                index % 2 ? "#e755a6" : "#bd75b4",
                index % 2 ? 0.62 : 0.46,
                0.0042,
            );
        }

        // Motas serigrafiadas del Huevo-K central
        const speckPositions: number[] = [];
        const speckColors: number[] = [];
        const speckPalette = [
            new THREE.Color("#ed43a2"),
            new THREE.Color("#a862a1"),
            new THREE.Color("#f58cbd"),
        ];
        let seed = 17;
        const random = () => {
            seed = (seed * 16807) % 2147483647;
            return (seed - 1) / 2147483646;
        };
        for (let i = 0; i < 520; i++) {
            const latitude = (random() - 0.5) * Math.PI * 0.84;
            const longitude = random() * Math.PI * 2;
            const point = eggPoint(latitude, longitude, 0.018);
            if (Math.sin(longitude) > 0.35 && Math.abs(point.x) < 0.78 && Math.abs(point.y) < 0.78)
                continue;
            speckPositions.push(point.x, point.y, point.z);
            const speckColor = speckPalette[Math.floor(random() * speckPalette.length)];
            if (speckColor) speckColors.push(...speckColor.toArray());
        }
        const specksGeo = new THREE.BufferGeometry();
        specksGeo.setAttribute("position", new THREE.Float32BufferAttribute(speckPositions, 3));
        specksGeo.setAttribute("color", new THREE.Float32BufferAttribute(speckColors, 3));
        sunEggGroup.add(
            new THREE.Points(
                specksGeo,
                new THREE.PointsMaterial({
                    size: 0.014,
                    vertexColors: true,
                    transparent: true,
                    opacity: 0.72,
                    sizeAttenuation: true,
                }),
            ),
        );

        // Silueta exterior del Huevo-K
        const outlinePoints: THREE.Vector3[] = [];
        for (let i = 0; i <= 96; i++) {
            const latitude = -Math.PI / 2 + (Math.PI * i) / 96;
            const radius = EGG_RADIUS * Math.cos(latitude) * (1 - 0.19 * Math.sin(latitude));
            outlinePoints.push(new THREE.Vector3(radius, EGG_HEIGHT * Math.sin(latitude), 0.015));
        }
        for (let i = 96; i >= 0; i--) {
            const latitude = -Math.PI / 2 + (Math.PI * i) / 96;
            const radius = EGG_RADIUS * Math.cos(latitude) * (1 - 0.19 * Math.sin(latitude));
            outlinePoints.push(new THREE.Vector3(-radius, EGG_HEIGHT * Math.sin(latitude), 0.015));
        }
        const sunOutlineMat = new THREE.LineBasicMaterial({ color: "#704579", linewidth: 2 });
        sunEggGroup.add(
            new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(outlinePoints), sunOutlineMat),
        );

        // Letra K pixelada extruida del Huevo-K central
        function makeKShape(): THREE.Shape {
            const shape = new THREE.Shape();
            const pixel = 0.071;
            const corners: [number, number][] = [
                [-0.56, -0.68],
                [-0.16, -0.68],
                [-0.16, -0.22],
                [0.31, -0.68],
                [0.78, -0.68],
                [0.16, 0],
                [0.77, 0.68],
                [0.29, 0.68],
                [-0.16, 0.22],
                [-0.16, 0.68],
                [-0.56, 0.68],
            ].map(([x, y]) => [Math.round(x / pixel), Math.round(y / pixel)]);
            const start = corners[0];
            if (start) shape.moveTo(start[0] * pixel, start[1] * pixel);
            for (let segment = 0; segment < corners.length; segment++) {
                const corner = corners[segment];
                const next = corners[(segment + 1) % corners.length];
                if (!corner || !next) continue;
                let [x, y] = corner;
                const [endX, endY] = next;
                const dx = Math.abs(endX - x);
                const dy = Math.abs(endY - y);
                const stepX = x < endX ? 1 : -1;
                const stepY = y < endY ? 1 : -1;
                let error = dx - dy;
                while (x !== endX || y !== endY) {
                    const doubledError = 2 * error;
                    const moveX = doubledError > -dy;
                    const moveY = doubledError < dx;
                    if (moveX) error -= dy;
                    if (moveY) error += dx;
                    if (moveX) {
                        x += stepX;
                        shape.lineTo(x * pixel, y * pixel);
                    }
                    if (moveY) {
                        y += stepY;
                        shape.lineTo(x * pixel, y * pixel);
                    }
                }
            }
            shape.closePath();
            return shape;
        }

        const kShape = makeKShape();
        const backingGeo = new THREE.ExtrudeGeometry(kShape, {
            depth: 0.12,
            bevelEnabled: false,
            curveSegments: 1,
        });
        backingGeo.translate(0, 0, 1.21);
        const backing = new THREE.Mesh(
            backingGeo,
            new THREE.MeshStandardMaterial({ color: "#e63d9b", roughness: 0.38, metalness: 0.06 }),
        );
        backing.scale.setScalar(1.11);
        sunEggGroup.add(backing);

        const faceGeo = new THREE.ExtrudeGeometry(kShape, {
            depth: 0.14,
            bevelEnabled: false,
            curveSegments: 1,
        });
        faceGeo.translate(0, 0, 1.18);
        const face = new THREE.Mesh(
            faceGeo,
            new THREE.MeshStandardMaterial({
                color: "#ffffff",
                roughness: 0.31,
                metalness: 0.02,
                emissive: "#fff7fc",
                emissiveIntensity: 0.12,
            }),
        );
        face.position.z = 0.24;
        sunEggGroup.add(face);

        // Corona astrolabio de base bajo el Huevo-K central
        const astrolabeBase = new THREE.Group();
        astrolabeBase.position.y = -1.62;
        planetariumRoot.add(astrolabeBase);

        const baseInnerRing = new THREE.Mesh(
            new THREE.RingGeometry(0.95, 0.98, 64),
            new THREE.MeshBasicMaterial({
                color: "#ed43a2",
                side: THREE.DoubleSide,
                transparent: true,
                opacity: 0.45,
            }),
        );
        baseInnerRing.rotation.x = -Math.PI / 2;
        astrolabeBase.add(baseInnerRing);

        const baseOuterRing = new THREE.Mesh(
            new THREE.RingGeometry(1.32, 1.34, 64),
            new THREE.MeshBasicMaterial({
                color: "#bd75b4",
                side: THREE.DoubleSide,
                transparent: true,
                opacity: 0.32,
            }),
        );
        baseOuterRing.rotation.x = -Math.PI / 2;
        astrolabeBase.add(baseOuterRing);

        // -----------------------------------------------------------------
        // 2. PLANO ECLÍPTICO Y LOS 8 HUEVOS-PLANETA PERSISTENTES
        // -----------------------------------------------------------------
        // Inclinamos suavemente el plano eclíptico para que todas las órbitas y huevos-planeta
        // se lean con profundidad tridimensional sin taparse unos a otros
        const eclipticPlane = new THREE.Group();
        eclipticPlane.rotation.x = 0.16;
        eclipticPlane.rotation.z = -0.04;
        planetariumRoot.add(eclipticPlane);

        const ORBIT_RX = 3.55;
        const ORBIT_RZ = 2.75;

        // Pista elíptica principal + marcas graduadas de astrolabio
        const orbitCurvePts: THREE.Vector3[] = [];
        for (let i = 0; i < 160; i++) {
            const a = (i / 160) * Math.PI * 2;
            orbitCurvePts.push(new THREE.Vector3(Math.sin(a) * ORBIT_RX, 0, Math.cos(a) * ORBIT_RZ));
        }
        const orbitCurve = new THREE.CatmullRomCurve3(orbitCurvePts, true);
        const orbitTrackMesh = new THREE.Mesh(
            new THREE.TubeGeometry(orbitCurve, 180, 0.007, 6, true),
            new THREE.MeshBasicMaterial({ color: "#ed43a2", transparent: true, opacity: 0.38 }),
        );
        eclipticPlane.add(orbitTrackMesh);

        // Segunda pista concéntrica fina
        const innerTrackPts: THREE.Vector3[] = [];
        for (let i = 0; i < 120; i++) {
            const a = (i / 120) * Math.PI * 2;
            innerTrackPts.push(
                new THREE.Vector3(Math.sin(a) * (ORBIT_RX * 0.72), 0, Math.cos(a) * (ORBIT_RZ * 0.72)),
            );
        }
        eclipticPlane.add(
            new THREE.LineLoop(
                new THREE.BufferGeometry().setFromPoints(innerTrackPts),
                new THREE.LineBasicMaterial({ color: "#bd75b4", transparent: true, opacity: 0.24 }),
            ),
        );

        // Definición de la estética individual de cada uno de los 8 Huevos-Planeta
        interface PlanetArchetype {
            shellTint: string;
            primaryLine: string;
            secondaryLine: string;
            tiltZ: number;
            baseScale: number;
            feature: "saturn" | "banded" | "armillary" | "polar" | "molecular" | "editorial" | "pulsar" | "classic";
        }

        const planetArchetypes: PlanetArchetype[] = [
            // 01 Perfil: Huevo Clásico Nacarado con anillo fino
            {
                shellTint: "#ffdff0",
                primaryLine: "#ed43a2",
                secondaryLine: "#bd75b4",
                tiltZ: 0.14,
                baseScale: 0.25,
                feature: "classic",
            },
            // 02 Experiencia (Goalmed): Gigante Bandeado con doble anillo
            {
                shellTint: "#f6c8ea",
                primaryLine: "#e63d9b",
                secondaryLine: "#8e489c",
                tiltZ: -0.22,
                baseScale: 0.29,
                feature: "banded",
            },
            // 03 Apps & Hackathons: Huevo Saturno con anillos anchos inclinados
            {
                shellTint: "#ffe3f4",
                primaryLine: "#ff4db2",
                secondaryLine: "#bd75b4",
                tiltZ: 0.26,
                baseScale: 0.28,
                feature: "saturn",
            },
            // 04 Linux & Neovim: Huevo Polar Cyber-Grid
            {
                shellTint: "#ead0f8",
                primaryLine: "#b845f2",
                secondaryLine: "#ed43a2",
                tiltZ: -0.16,
                baseScale: 0.26,
                feature: "polar",
            },
            // 05 Habilidades (Stack): Esfera Armilar / Giroscopio de 3 anillos
            {
                shellTint: "#ffd6ec",
                primaryLine: "#ed43a2",
                secondaryLine: "#9c55a8",
                tiltZ: 0.1,
                baseScale: 0.27,
                feature: "armillary",
            },
            // 06 Educación (Química): Huevo Molecular con átomos orbitales
            {
                shellTint: "#f9d8f2",
                primaryLine: "#d43d9a",
                secondaryLine: "#bd75b4",
                tiltZ: -0.2,
                baseScale: 0.25,
                feature: "molecular",
            },
            // 07 Blog: Huevo Editorial con meridianos densos
            {
                shellTint: "#ffe8f5",
                primaryLine: "#e63d9b",
                secondaryLine: "#a862a1",
                tiltZ: 0.18,
                baseScale: 0.26,
                feature: "editorial",
            },
            // 08 Contacto: Huevo Pulsar con halos polares
            {
                shellTint: "#ffd1ea",
                primaryLine: "#ff55b5",
                secondaryLine: "#ed43a2",
                tiltZ: -0.14,
                baseScale: 0.25,
                feature: "pulsar",
            },
        ];

        // Etiqueta compacta tipo píldora para cada Huevo-Planeta (sin tapar la geometría 3D)
        function createCompactPillSprite(
            numText: string,
            labelText: string,
            isSelected: boolean,
        ): THREE.Sprite {
            const isLight = document.documentElement.dataset.theme === "light";
            const canvas = document.createElement("canvas");
            canvas.width = 360;
            canvas.height = 72;
            const ctx = canvas.getContext("2d");
            if (ctx) {
                const pad = 6;
                const w = canvas.width - pad * 2;
                const h = canvas.height - pad * 2;

                ctx.fillStyle = isSelected
                    ? "#ed43a2"
                    : isLight
                      ? "rgba(255, 255, 255, 0.9)"
                      : "rgba(32, 22, 38, 0.86)";
                ctx.strokeStyle = isSelected
                    ? "#ffffff"
                    : isLight
                      ? "rgba(189, 117, 180, 0.65)"
                      : "rgba(232, 171, 216, 0.5)";
                ctx.lineWidth = isSelected ? 2.5 : 1.8;
                ctx.beginPath();
                ctx.roundRect(pad, pad, w, h, 30);
                ctx.fill();
                ctx.stroke();

                ctx.font = '700 22px "Pixelify Sans", monospace, sans-serif';
                ctx.fillStyle = isSelected ? "#ffffff" : "#ed43a2";
                ctx.fillText(numText, pad + 20, pad + 38);

                ctx.font = '600 21px "Plus Jakarta Sans", sans-serif';
                ctx.fillStyle = isSelected ? "#ffffff" : isLight ? "#2a1e2e" : "#fff0f8";
                const clipped = labelText.length > 15 ? labelText.slice(0, 14) + "…" : labelText;
                ctx.fillText(clipped, pad + 62, pad + 38);
            }

            const tex = new THREE.CanvasTexture(canvas);
            tex.colorSpace = THREE.SRGBColorSpace;
            const sprite = new THREE.Sprite(
                new THREE.SpriteMaterial({
                    map: tex,
                    transparent: true,
                    depthWrite: false,
                    opacity: isSelected ? 1.0 : 0.82,
                }),
            );
            const wScale = isSelected ? 1.38 : 1.08;
            sprite.scale.set(wScale, wScale * (72 / 360), 1);
            return sprite;
        }

        // Construir un Huevo-Planeta con la misma delicadeza serigrafiada que el Huevo-K
        interface PlanetInstance {
            stationIdx: number;
            baseAngle: number;
            heightOffset: number;
            anchorGroup: THREE.Group;
            eggSpinGroup: THREE.Group;
            shellMat: THREE.MeshPhysicalMaterial;
            hitMesh: THREE.Mesh;
            badgeHolder: THREE.Group;
            gyroRings: THREE.Object3D[];
            baseScale: number;
            currentScale: number;
        }

        const planetInstances: PlanetInstance[] = [];

        cvList.forEach((station, sIdx) => {
            const arch = planetArchetypes[sIdx % planetArchetypes.length]!;
            const baseAngle = (sIdx / cvList.length) * Math.PI * 2;
            const heightOffset = Math.sin(sIdx * 1.7) * 0.16;

            const anchorGroup = new THREE.Group();
            eclipticPlane.add(anchorGroup);

            const tiltGroup = new THREE.Group();
            tiltGroup.rotation.z = arch.tiltZ;
            anchorGroup.add(tiltGroup);

            const eggSpinGroup = new THREE.Group();
            tiltGroup.add(eggSpinGroup);

            // Cáscara translúcida del Huevo-Planeta (sin núcleo opaco que ensucie el interior)
            const shellMat = new THREE.MeshPhysicalMaterial({
                color: arch.shellTint,
                roughness: 0.3,
                metalness: 0.05,
                clearcoat: 0.55,
                transparent: true,
                opacity: 0.46,
                depthWrite: false,
                side: THREE.DoubleSide,
            });
            const hitMesh = new THREE.Mesh(sharedPlanetEggGeo, shellMat);
            hitMesh.userData = {
                type: "planet",
                stationIdx: sIdx,
                itemIdx: 0,
                label: `${station.index} · ${station.navLabel}`,
            };
            eggSpinGroup.add(hitMesh);

            // Paralelos serigrafiados finos sobre el Huevo-Planeta
            const latCount = arch.feature === "banded" ? 6 : 4;
            for (let l = -latCount; l <= latCount; l++) {
                if (l === 0 && arch.feature !== "banded") continue;
                const lat = (l / (latCount + 1)) * (Math.PI * 0.44);
                const pts = Array.from({ length: 57 }, (_, i) =>
                    eggPoint(lat, (Math.PI * 2 * i) / 56, 0.012),
                );
                addTubeLine(
                    eggSpinGroup,
                    pts,
                    l % 2 === 0 ? arch.primaryLine : arch.secondaryLine,
                    0.75,
                    arch.feature === "banded" && l % 2 === 0 ? 0.014 : 0.008,
                );
            }

            // Meridianos serigrafiados sobre el Huevo-Planeta
            const merCount = arch.feature === "editorial" ? 12 : 8;
            for (let m = 0; m < merCount; m++) {
                const lon = (Math.PI * 2 * m) / merCount;
                const pts = Array.from({ length: 41 }, (_, i) =>
                    eggPoint(-Math.PI / 2 + (Math.PI * i) / 40, lon, 0.012),
                );
                addTubeLine(
                    eggSpinGroup,
                    pts,
                    m % 2 === 0 ? arch.primaryLine : arch.secondaryLine,
                    0.58,
                    0.007,
                );
            }

            // Rasgo astronómico distintivo de cada Huevo-Planeta
            const gyroRings: THREE.Object3D[] = [];

            if (arch.feature === "classic" || arch.feature === "editorial") {
                const ring = new THREE.Mesh(
                    new THREE.TorusGeometry(1.55, 0.018, 12, 72),
                    new THREE.MeshBasicMaterial({
                        color: arch.primaryLine,
                        transparent: true,
                        opacity: 0.72,
                    }),
                );
                ring.rotation.x = Math.PI * 0.48;
                tiltGroup.add(ring);
                gyroRings.push(ring);
            } else if (arch.feature === "saturn" || arch.feature === "banded") {
                const r1 = new THREE.Mesh(
                    new THREE.TorusGeometry(1.52, 0.024, 12, 80),
                    new THREE.MeshBasicMaterial({
                        color: arch.primaryLine,
                        transparent: true,
                        opacity: 0.8,
                    }),
                );
                r1.rotation.x = Math.PI * 0.47;
                tiltGroup.add(r1);

                const r2 = new THREE.Mesh(
                    new THREE.TorusGeometry(1.82, 0.015, 12, 80),
                    new THREE.MeshBasicMaterial({
                        color: arch.secondaryLine,
                        transparent: true,
                        opacity: 0.55,
                    }),
                );
                r2.rotation.x = Math.PI * 0.47;
                tiltGroup.add(r2);
                gyroRings.push(r1, r2);
            } else if (arch.feature === "armillary") {
                for (let g = 0; g < 3; g++) {
                    const ring = new THREE.Mesh(
                        new THREE.TorusGeometry(1.48 + g * 0.16, 0.016, 10, 64),
                        new THREE.MeshBasicMaterial({
                            color: g % 2 === 0 ? arch.primaryLine : arch.secondaryLine,
                            transparent: true,
                            opacity: 0.7,
                        }),
                    );
                    ring.rotation.x = (Math.PI / 3) * g;
                    ring.rotation.y = (Math.PI / 4) * g;
                    tiltGroup.add(ring);
                    gyroRings.push(ring);
                }
            } else if (arch.feature === "polar") {
                const polar1 = new THREE.Mesh(
                    new THREE.TorusGeometry(1.58, 0.02, 12, 72),
                    new THREE.MeshBasicMaterial({
                        color: arch.primaryLine,
                        transparent: true,
                        opacity: 0.78,
                    }),
                );
                polar1.rotation.y = Math.PI * 0.25;
                tiltGroup.add(polar1);

                const polar2 = new THREE.Mesh(
                    new THREE.TorusGeometry(1.58, 0.016, 12, 72),
                    new THREE.MeshBasicMaterial({
                        color: arch.secondaryLine,
                        transparent: true,
                        opacity: 0.52,
                    }),
                );
                polar2.rotation.y = -Math.PI * 0.25;
                tiltGroup.add(polar2);
                gyroRings.push(polar1, polar2);
            } else if (arch.feature === "molecular") {
                const molGroup = new THREE.Group();
                const orbitTorus = new THREE.Mesh(
                    new THREE.TorusGeometry(1.62, 0.012, 10, 64),
                    new THREE.MeshBasicMaterial({
                        color: arch.primaryLine,
                        transparent: true,
                        opacity: 0.6,
                    }),
                );
                orbitTorus.rotation.x = Math.PI * 0.42;
                molGroup.add(orbitTorus);

                for (let a = 0; a < 4; a++) {
                    const ang = (a / 4) * Math.PI * 2;
                    const atom = new THREE.Mesh(
                        new THREE.SphereGeometry(0.11, 12, 12),
                        new THREE.MeshStandardMaterial({
                            color: "#ed43a2",
                            emissive: "#ed43a2",
                            emissiveIntensity: 0.4,
                        }),
                    );
                    atom.position.set(Math.cos(ang) * 1.62, Math.sin(ang) * 0.28, Math.sin(ang) * 1.58);
                    molGroup.add(atom);
                }
                tiltGroup.add(molGroup);
                gyroRings.push(molGroup);
            } else if (arch.feature === "pulsar") {
                for (let p = -1; p <= 1; p += 2) {
                    const halo = new THREE.Mesh(
                        new THREE.TorusGeometry(0.95, 0.018, 10, 48),
                        new THREE.MeshBasicMaterial({
                            color: arch.primaryLine,
                            transparent: true,
                            opacity: 0.75,
                        }),
                    );
                    halo.rotation.x = Math.PI / 2;
                    halo.position.y = p * 1.15;
                    tiltGroup.add(halo);
                    gyroRings.push(halo);
                }
            }

            const badgeHolder = new THREE.Group();
            anchorGroup.add(badgeHolder);

            planetInstances.push({
                stationIdx: sIdx,
                baseAngle,
                heightOffset,
                anchorGroup,
                eggSpinGroup: tiltGroup,
                shellMat,
                hitMesh,
                badgeHolder,
                gyroRings,
                baseScale: arch.baseScale,
                currentScale: arch.baseScale,
            });
        });

        function refreshPlanetBadges() {
            const isLight = document.documentElement.dataset.theme === "light";
            planetInstances.forEach((pInst) => {
                while (pInst.badgeHolder.children.length > 0) {
                    pInst.badgeHolder.remove(pInst.badgeHolder.children[0]!);
                }
                const st = cvList[pInst.stationIdx];
                if (!st) return;
                const isSelected = pInst.stationIdx === activeStationIdx;
                const pill = createCompactPillSprite(st.index, st.navLabel, isSelected);
                pill.position.set(0, isSelected ? 0.72 : 0.5, 0);
                pInst.badgeHolder.add(pill);

                pInst.shellMat.opacity = isSelected
                    ? isLight
                        ? 0.72
                        : 0.56
                    : isLight
                      ? 0.48
                      : 0.34;
            });
        }

        // -----------------------------------------------------------------
        // 3. SISTEMA DE HUEVOS-LUNA ORBITANDO AL HUEVO-PLANETA ACTIVO
        // -----------------------------------------------------------------
        const activeMoonSystem = new THREE.Group();
        eclipticPlane.add(activeMoonSystem);

        // Anillo de órbita lunar alrededor del Huevo-Planeta activo
        const lunarTrackRing = new THREE.Mesh(
            new THREE.TorusGeometry(0.88, 0.0045, 10, 72),
            new THREE.MeshBasicMaterial({
                color: "#f58cbd",
                transparent: true,
                opacity: 0.55,
            }),
        );
        lunarTrackRing.rotation.x = Math.PI * 0.38;
        activeMoonSystem.add(lunarTrackRing);

        const moonItemsGroup = new THREE.Group();
        activeMoonSystem.add(moonItemsGroup);

        // Hilo de luz entre el Huevo Central con la K y el Huevo-Planeta activo
        const sunToPlanetBeamGeo = new THREE.BufferGeometry().setFromPoints([
            new THREE.Vector3(),
            new THREE.Vector3(),
        ]);
        const sunToPlanetBeam = new THREE.Line(
            sunToPlanetBeamGeo,
            new THREE.LineBasicMaterial({ color: "#ed43a2", transparent: true, opacity: 0.52 }),
        );
        eclipticPlane.add(sunToPlanetBeam);

        interface MoonNode {
            wrapper: THREE.Group;
            hitMesh: THREE.Mesh;
            itemIdx: number;
            angle: number;
        }

        let activeMoonNodes: MoonNode[] = [];

        function rebuildMoonSatellites() {
            while (moonItemsGroup.children.length > 0) {
                moonItemsGroup.remove(moonItemsGroup.children[0]!);
            }
            activeMoonNodes = [];

            const station = cvList[activeStationIdx];
            if (!station) return;

            const count = station.items.length;
            station.items.forEach((item, iIdx) => {
                const isSelectedMoon = iIdx === activeItemIdx;
                const angle = (iIdx / count) * Math.PI * 2;

                const wrapper = new THREE.Group();

                // Mini Huevo-Luna con estética de huevo serigrafiado
                const moonEggGroup = new THREE.Group();
                const moonScale = isSelectedMoon ? 0.095 : 0.068;
                moonEggGroup.scale.setScalar(moonScale);
                moonEggGroup.rotation.z = 0.15;

                const moonHitMesh = new THREE.Mesh(
                    sharedMoonEggGeo,
                    new THREE.MeshPhysicalMaterial({
                        color: isSelectedMoon ? "#ed43a2" : "#ffdff0",
                        emissive: "#ed43a2",
                        emissiveIntensity: isSelectedMoon ? 0.55 : 0.18,
                        roughness: 0.25,
                        clearcoat: 0.6,
                        transparent: true,
                        opacity: isSelectedMoon ? 0.95 : 0.75,
                    }),
                );
                moonHitMesh.userData = {
                    type: "moon",
                    stationIdx: activeStationIdx,
                    itemIdx: iIdx,
                    label: `${station.index}.${iIdx + 1} · ${item.title}`,
                };
                moonEggGroup.add(moonHitMesh);

                // Anillo ecuatorial fino en el Huevo-Luna seleccionado
                const eqRing = new THREE.Mesh(
                    new THREE.TorusGeometry(1.38, 0.04, 8, 36),
                    new THREE.MeshBasicMaterial({
                        color: isSelectedMoon ? "#ffffff" : "#ed43a2",
                        transparent: true,
                        opacity: isSelectedMoon ? 0.9 : 0.45,
                    }),
                );
                eqRing.rotation.x = Math.PI * 0.45;
                moonEggGroup.add(eqRing);

                wrapper.add(moonEggGroup);

                // Solo mostramos una píldora flotante sobre la Luna actualmente seleccionada
                // para mantener el espacio 3D ultra limpio y despejado
                if (isSelectedMoon) {
                    const moonPill = createCompactPillSprite(
                        `${station.index}.${iIdx + 1}`,
                        item.title,
                        true,
                    );
                    moonPill.scale.multiplyScalar(0.76);
                    moonPill.position.set(0, 0.24, 0);
                    wrapper.add(moonPill);
                }

                moonItemsGroup.add(wrapper);
                activeMoonNodes.push({
                    wrapper,
                    hitMesh: moonHitMesh,
                    itemIdx: iIdx,
                    angle,
                });
            });
        }

        function syncThemeColors() {
            const isLight = document.documentElement.dataset.theme === "light";
            sunShellMat.color.set(isLight ? "#f7cfe6" : "#ffdff0");
            sunShellMat.opacity = isLight ? 0.52 : 0.38;
            sunOutlineMat.color.set(isLight ? "#5c3366" : "#704579");
            refreshPlanetBadges();
            rebuildMoonSatellites();
        }

        window.addEventListener("themechange", syncThemeColors);
        syncThemeColors();

        // -----------------------------------------------------------------
        // 4. INTERACCIÓN: RUEDA, CLIC EN PLANETAS/LUNAS Y ARRASTRE 3D
        // -----------------------------------------------------------------
        const raycaster = new THREE.Raycaster();
        const pointerNdc = new THREE.Vector2();

        function getClickableMeshes(): THREE.Object3D[] {
            return [
                ...planetInstances.map((p) => p.hitMesh),
                ...activeMoonNodes.map((m) => m.hitMesh),
            ];
        }

        let wheelLock = false;
        renderer.domElement.addEventListener(
            "wheel",
            (e) => {
                if (document.documentElement.dataset.view === "2d") return;
                e.preventDefault();
                if (wheelLock) return;
                wheelLock = true;
                autoTour = false;

                const dir = Math.sign(e.deltaY);
                if (dir !== 0) {
                    selectStationAndItem(activeStationIdx + dir, 0);
                }
                window.setTimeout(() => {
                    wheelLock = false;
                }, 280);
            },
            { passive: false },
        );

        renderer.domElement.addEventListener("pointerdown", (e) => {
            isDragging = true;
            dragMoved = false;
            pointerDownPos = { x: e.clientX, y: e.clientY };
        });

        window.addEventListener("pointermove", (e) => {
            if (document.documentElement.dataset.view === "2d") return;
            const rect = renderer.domElement.getBoundingClientRect();
            if (rect.width === 0 || rect.height === 0) return;

            pointerNdc.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
            pointerNdc.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

            if (isDragging) {
                const dx = e.clientX - pointerDownPos.x;
                const dy = e.clientY - pointerDownPos.y;
                if (Math.hypot(dx, dy) > 4) dragMoved = true;
                userYaw = Math.max(-1.4, Math.min(1.4, userYaw + dx * 0.005));
                userPitch = Math.max(-0.55, Math.min(0.55, userPitch + dy * 0.004));
                pointerDownPos = { x: e.clientX, y: e.clientY };
                return;
            }

            raycaster.setFromCamera(pointerNdc, camera);
            const hits = raycaster.intersectObjects(getClickableMeshes(), false);
            const hit = hits[0];
            if (hit && hoverTooltipEl) {
                const data = hit.object.userData as { label?: string };
                renderer.domElement.style.cursor = "pointer";
                hoverTooltipEl.textContent = `🥚 ${data.label ?? "Inspeccionar"}`;
                hoverTooltipEl.style.left = `${e.clientX + 14}px`;
                hoverTooltipEl.style.top = `${e.clientY + 14}px`;
                hoverTooltipEl.classList.add("visible");
            } else {
                renderer.domElement.style.cursor = isDragging ? "grabbing" : "grab";
                hoverTooltipEl?.classList.remove("visible");
            }
        });

        window.addEventListener("pointerup", (e) => {
            if (isDragging && !dragMoved && document.documentElement.dataset.view !== "2d") {
                const rect = renderer.domElement.getBoundingClientRect();
                pointerNdc.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
                pointerNdc.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
                raycaster.setFromCamera(pointerNdc, camera);
                const hits = raycaster.intersectObjects(getClickableMeshes(), false);
                const firstHit = hits[0];
                if (firstHit) {
                    const data = firstHit.object.userData as {
                        stationIdx: number;
                        itemIdx: number;
                    };
                    selectStationAndItem(data.stationIdx, data.itemIdx);
                }
            }
            isDragging = false;
        });

        window.addEventListener("keydown", (e) => {
            if (document.documentElement.dataset.view === "2d") return;
            const activeTag = document.activeElement?.tagName.toLowerCase();
            if (activeTag === "input" || activeTag === "textarea") return;

            if (e.key === "ArrowDown" || e.key === "s" || e.key === "S") {
                e.preventDefault();
                selectStationAndItem(activeStationIdx + 1, 0);
            } else if (e.key === "ArrowUp" || e.key === "w" || e.key === "W") {
                e.preventDefault();
                selectStationAndItem(activeStationIdx - 1, 0);
            } else if (e.key === "ArrowRight" || e.key === "d" || e.key === "D") {
                e.preventDefault();
                const st = cvList[activeStationIdx];
                if (!st) return;
                selectStationAndItem(activeStationIdx, (activeItemIdx + 1) % st.items.length);
            } else if (e.key === "ArrowLeft" || e.key === "a" || e.key === "A") {
                e.preventDefault();
                const st = cvList[activeStationIdx];
                if (!st) return;
                selectStationAndItem(
                    activeStationIdx,
                    (activeItemIdx - 1 + st.items.length) % st.items.length,
                );
            }
        });

        // -----------------------------------------------------------------
        // 5. ENCUADRE RESPONSIVO Y CICLO DE ANIMACIÓN 60FPS
        // -----------------------------------------------------------------
        const updateLayoutOffset = () => {
            const width = container.clientWidth;
            const height = container.clientHeight;
            if (width === 0 || height === 0) return;
            camera.aspect = width / height;
            camera.updateProjectionMatrix();
            camera.lookAt(0, -0.05, 0);
            renderer.setSize(width, height, false);

            const isMobile = width < 920;
            planetariumRoot.position.x = isMobile ? 0 : 1.45;
            planetariumRoot.position.y = isMobile ? 0.85 : 0.18;
            planetariumRoot.scale.setScalar(isMobile ? 0.72 : 0.98);
        };

        new ResizeObserver(updateLayoutOffset).observe(container);
        updateLayoutOffset();

        let rafId = 0;
        let lastTime = performance.now();
        const startTime = lastTime;

        function animate() {
            rafId = requestAnimationFrame(animate);
            const now = performance.now();
            const dt = Math.min((now - lastTime) / 1000, 0.1);
            lastTime = now;
            const elapsed = (now - startTime) / 1000;

            if (autoTour) {
                autoTourTimer += dt;
                if (autoTourTimer > 4.0) {
                    autoTourTimer = 0;
                    const st = cvList[activeStationIdx];
                    if (st && activeItemIdx < st.items.length - 1) {
                        selectStationAndItem(activeStationIdx, activeItemIdx + 1);
                    } else {
                        selectStationAndItem(activeStationIdx + 1, 0);
                    }
                }
            }

            currentSystemAngle += (targetSystemAngle - currentSystemAngle) * 0.075;
            currentYaw += (userYaw - currentYaw) * 0.09;
            currentPitch += (userPitch - currentPitch) * 0.09;

            // 1. Animación del Huevo-K Sol Central
            const idleSwing = reduceMotion ? 0 : Math.sin(elapsed * 0.65) * 0.2;
            sunEggGroup.rotation.y = idleSwing + currentYaw * 0.8;
            sunEggGroup.rotation.x = currentPitch * 0.5;
            if (!reduceMotion) {
                sunEggGroup.position.y = Math.sin(elapsed * 1.15) * 0.04;
                astrolabeBase.rotation.y = -elapsed * 0.12;
            }

            // Inclinación del plano eclíptico al arrastrar
            eclipticPlane.rotation.x = 0.16 + currentPitch * 0.45;

            // 2. Posición orbital de los 8 Huevos-Planeta y escala interpolada suave
            const totalOrbitAngle = currentSystemAngle + currentYaw * 0.75;
            let activePlanetPos = new THREE.Vector3();

            planetInstances.forEach((pInst, idx) => {
                const isSelected = idx === activeStationIdx;
                const angle = pInst.baseAngle + totalOrbitAngle;
                const px = Math.sin(angle) * ORBIT_RX;
                const py =
                    pInst.heightOffset +
                    (reduceMotion ? 0 : Math.sin(elapsed * 1.4 + idx) * 0.035);
                const pz = Math.cos(angle) * ORBIT_RZ;

                pInst.anchorGroup.position.set(px, py, pz);

                // Escala suave: el Huevo-Planeta activo crece para mostrar su arquitectura
                const targetScale = isSelected ? pInst.baseScale * 1.48 : pInst.baseScale * 0.88;
                pInst.currentScale += (targetScale - pInst.currentScale) * 0.1;
                pInst.eggSpinGroup.scale.setScalar(pInst.currentScale);

                if (!reduceMotion) {
                    pInst.eggSpinGroup.rotation.y = elapsed * (0.38 + (idx % 3) * 0.12);
                    pInst.gyroRings.forEach((r, rIdx) => {
                        r.rotation.z = elapsed * (0.3 + rIdx * 0.2) * (rIdx % 2 === 0 ? 1 : -1);
                    });
                }

                if (isSelected) {
                    activePlanetPos.set(px, py, pz);
                }
            });

            // 3. El sistema de Huevos-Luna orbita directamente alrededor del Huevo-Planeta activo
            activeMoonSystem.position.lerp(activePlanetPos, 0.18);
            sunToPlanetBeamGeo.setFromPoints([
                new THREE.Vector3(0, 0, 0),
                activeMoonSystem.position,
            ]);

            activeMoonNodes.forEach((mNode, mIdx) => {
                const isSelectedMoon = mNode.itemIdx === activeItemIdx;
                const moonAngle =
                    mNode.angle +
                    (reduceMotion ? 0 : elapsed * 0.45) -
                    (activeItemIdx / Math.max(1, activeMoonNodes.length)) * Math.PI * 0.5;
                const lunarRadius = isSelectedMoon ? 0.92 : 0.84;
                const mx = Math.sin(moonAngle) * lunarRadius;
                const my = Math.cos(moonAngle) * Math.sin(Math.PI * 0.38) * 0.32;
                const mz = Math.cos(moonAngle) * lunarRadius;
                mNode.wrapper.position.set(mx, my, mz);

                if (!reduceMotion) {
                    const moonEgg = mNode.wrapper.children[0];
                    if (moonEgg) moonEgg.rotation.y = elapsed * (0.8 + mIdx * 0.15);
                }
            });

            renderer.render(scene, camera);
        }

        function syncRenderLoop() {
            const is3dView = document.documentElement.dataset.view !== "2d";
            const shouldRun = is3dView && !document.hidden;
            if (shouldRun && rafId === 0) {
                lastTime = performance.now();
                updateLayoutOffset();
                rafId = requestAnimationFrame(animate);
            } else if (!shouldRun && rafId !== 0) {
                cancelAnimationFrame(rafId);
                rafId = 0;
            }
        }

        window.addEventListener("viewmodechange", syncRenderLoop);
        document.addEventListener("visibilitychange", syncRenderLoop);
        syncRenderLoop();
    }
</script>
