---
import "../styles/styles.css";
import ProjectCard from "./project-card.astro";
import { projects, projectFilters } from "../data/projectsData";
import { projectsEn, projectFiltersEn } from "../data/cvDataEn";

interface Props {
    limit?: number;
    showFilters?: boolean;
    lang?: "es" | "en";
}

const { limit, showFilters = !limit, lang = "es" } = Astro.props;
const isEn = lang === "en";
const list = isEn ? projectsEn : projects;
const filters = isEn ? projectFiltersEn : projectFilters;
const visibleProjects = typeof limit === "number" ? list.slice(0, limit) : list;
---

<section>
    <div class="mb-4">
        <p class="section-label">{isEn ? "03 — Projects" : "03 — Proyectos"}</p>
        <h2 class="mb-2">{isEn ? "Applications & Open Source" : "Aplicaciones y código abierto"}</h2>
        <p class="section-desc">
            {
                isEn
                    ? limit
                        ? "Featured recent GitHub projects across web dashboards, Neovim tooling, and desktop apps."
                        : "Complete catalog of GitHub repositories: web and mobile apps, local AI agents, Neovim plugins, and Linux automation."
                    : limit
                      ? "Últimos proyectos publicados en GitHub sobre web, agentes de IA locales y herramientas para Linux."
                      : "Catálogo completo de proyectos en GitHub: aplicaciones web y móviles, agentes de IA locales, plugins de Neovim y automatización Linux."
            }
        </p>
    </div>

    {
        showFilters && (
            <div class="filter-chips mb-4" role="group" aria-label={isEn ? "Filter projects by technology" : "Filtrar proyectos por tecnología"}>
                {filters.map((f, idx) => (
                    <button
                        class={`filter-chip ${idx === 0 ? "active-chip" : ""}`}
                        data-filter={f.id}
                    >
                        {f.label}
                    </button>
                ))}
            </div>
        )
    }

    <div class="project-grid">
        {
            visibleProjects.map((project) => (
                <ProjectCard
                    title={project.title}
                    href={project.href}
                    description={project.description}
                    tag={project.tag}
                    date={project.date}
                    homepage={project.homepage}
                />
            ))
        }
    </div>

    {
        limit && list.length > limit && (
            <div class="mt-4">
                <a href={isEn ? "/en/projects" : "/galery-projects"} class="btn-secondary">
                    {isEn ? `View all projects (${list.length}) →` : `Ver todos los proyectos (${list.length}) →`}
                </a>
            </div>
        )
    }
</section>

{
    showFilters && (
        <script is:inline>
            (function () {
                const chips = document.querySelectorAll('.filter-chip');
                const cards = document.querySelectorAll('.project-card');
                if (!chips.length || !cards.length) return;

                chips.forEach(function (chip) {
                    chip.addEventListener('click', function () {
                        var filter = this.dataset.filter;

                        chips.forEach(function (c) {
                            c.classList.remove('active-chip');
                        });
                        this.classList.add('active-chip');

                        cards.forEach(function (card) {
                            var tags = card.dataset.tags || '';
                            card.classList.remove('visible');
                            if (filter === 'all' || tags.split(' ').indexOf(filter) !== -1) {
                                card.classList.add('visible');
                            }
                        });
                    });
                });
            })();
        </script>
    )
}
