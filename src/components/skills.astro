---
import "../styles/styles.css";
import ProjectCard from "./project-card.astro";

const projects = [
    {
        title: "Construhack 2025",
        href: "https://github.com/AndreaKinder/construhack2025",
        description:
            "Proyecto para ConstruHack 2025. Muestra con react native de app para solucion integral de gestion inteligente para viviendas y comunidades sostenibles.",
        tag: "react react-native git html javascript android",
    },
    {
        title: "Construhack 2024",
        href: "https://github.com/AndreaKinder/construhack2024",
        description:
            "Proyecto prueba piloto del proyecto Construhack 2024, una aplicacion de inteligencia artificial para la clasificacion automatica de sobrantes de obras civiles, con el objetivo de promover un sistema de economia circular.",
        tag: "react react-native git html javascript android",
    },
    {
        title: "Portfolio",
        href: "https://github.com/AndreaKinder/porfolio-kinder",
        description: "Mi portfolio personal, creado con Astro.",
        tag: "astro git bootstrap html javascript",
    },
    {
        title: "Wowfinder",
        href: "https://github.com/edurne85/wowfinder",
        description:
            "Paquete de utilidades para la campana 'Wowfinder' (campana de rol basada en el sistema Pathfinder 1ed y ambientada en el universo Warcraft de Blizzard).",
        tag: "react git html javascript",
    },
    {
        title: "SecureWallet",
        description:
            "Proyecto presentado en el Hackathon Open Gateway 2025, obteniendo el 4to lugar en la competencia.",
        href: "https://github.com/AndreaKinder/secureWallet/tree/main",
        tag: "react react-native git api javascript android",
    },
    {
        title: "Kinder.Vim",
        description:
            "Configuracion personalizada de Neovim.",
        href: "https://github.com/AndreaKinder/Kinder.Vim",
        tag: "linux bash git nvim",
    },
    {
        title: "Copilot CLI Neovim",
        description:
            "Plugin de Neovim que integra GitHub Copilot CLI para generar y ejecutar comandos de terminal desde el editor.",
        href: "https://github.com/AndreaKinder/copilot-cli.nvim",
        tag: "linux bash git nvim",
    },
    {
        title: "Kinder.Dots",
        description:
            "Esta es mi coleccion personal de dotfiles, disenados para crear un entorno de desarrollo y escritorio cohesivo y productivo.",
        href: "https://github.com/AndreaKinder/Kinder.Dots",
        tag: "linux bash git",
    },
    {
        title: "Kinder.Shell",
        description:
            "Configuraciones modernas y unificadas de shell para Fish, Bash y Zsh, disenadas para desarrollo profesional.",
        href: "https://github.com/AndreaKinder/Kinder.Shell",
        tag: "linux bash git",
    },
    {
        title: "RomsManager",
        description:
            "Gestor de ROMs para organizar y administrar colecciones de juegos retro.",
        href: "https://github.com/AndreaKinder/RomsManager",
        tag: "linux bash git",
    },
];
---

<section>
    <div class="text-center mb-5">
        <p class="section-label">Proyectos</p>
        <h2 class="mb-3">Lo que construi</h2>
        <p class="section-desc">
            Una seleccion de proyectos personales y colaborativos. Filtra por tecnologia para explorar.
        </p>
    </div>

    <div class="filter-chips mb-5">
        <button class="filter-chip active-chip" data-filter="linux">Linux</button>
        <button class="filter-chip" data-filter="bash">Bash</button>
        <button class="filter-chip" data-filter="react">React</button>
        <button class="filter-chip" data-filter="react-native">React Native</button>
        <button class="filter-chip" data-filter="git">Git</button>
        <button class="filter-chip" data-filter="html">HTML & CSS</button>
        <button class="filter-chip" data-filter="api">APIs REST</button>
        <button class="filter-chip" data-filter="javascript">JavaScript</button>
        <button class="filter-chip" data-filter="astro">Astro</button>
        <button class="filter-chip" data-filter="bootstrap">Bootstrap</button>
        <button class="filter-chip" data-filter="android">Android</button>
        <button class="filter-chip" data-filter="nvim">Neovim</button>
    </div>

    <div class="project-grid">
        {
            projects.map((project) => (
                <ProjectCard
                    title={project.title}
                    href={project.href}
                    description={project.description}
                    tag={project.tag}
                />
            ))
        }
    </div>

</section>

<script is:inline>
    (function() {
        const chips = document.querySelectorAll('.filter-chip');
        const cards = document.querySelectorAll('.project-card');
        if (!chips.length || !cards.length) return;

        chips.forEach(function(chip) {
            chip.addEventListener('click', function() {
                var filter = this.dataset.filter;

                chips.forEach(function(c) { c.classList.remove('active-chip'); });
                this.classList.add('active-chip');

                cards.forEach(function(card) {
                    var tags = card.dataset.tags || '';
                    card.classList.remove('visible');
                    if (tags.split(' ').indexOf(filter) !== -1) {
                        card.classList.add('visible');
                    }
                });
            });
        });
    })();
</script>

<style>
    .filter-chip {
        font-family: var(--font-body);
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--color-text-muted);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-full);
        padding: 0.5rem 1.125rem;
        cursor: pointer;
        transition:
            all var(--duration-normal) var(--ease-out);
        user-select: none;
        display: inline-block;
    }

    .filter-chip:hover {
        color: var(--color-text);
        border-color: var(--color-border-hover);
        background: var(--color-surface-hover);
        transform: translateY(-1px);
        box-shadow: var(--shadow-xs);
    }

    .filter-chip.active-chip {
        color: #ffffff;
        background: var(--color-accent);
        border-color: var(--color-accent);
        box-shadow: var(--shadow-sm);
    }

    .filter-chip.active-chip:hover {
        background: var(--color-accent-hover);
        border-color: var(--color-accent-hover);
        color: #ffffff;
    }
</style>
