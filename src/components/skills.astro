---
import "../styles/styles.css";
import ProjectCard from "./project-card.astro";

const projects = [
    {
        title: "Construhack 2025",
        href: "https://github.com/AndreaKinder/construhack2025",
        description:
            "Proyecto para ConstruHack 2025. Muestra con React Native de app para solución integral de gestión inteligente para viviendas y comunidades sostenibles.",
        tag: "react react-native git html javascript android",
    },
    {
        title: "SecureWallet",
        description:
            "Proyecto presentado en el Hackathon Open Gateway 2025, obteniendo el 4.º lugar en la competencia mediante integración de APIs de red y seguridad móvil.",
        href: "https://github.com/AndreaKinder/secureWallet/tree/main",
        tag: "react react-native git api javascript android",
    },
    {
        title: "Construhack 2024",
        href: "https://github.com/AndreaKinder/construhack2024",
        description:
            "Prueba piloto de una aplicación con inteligencia artificial para la clasificación automática de sobrantes de obras civiles, promoviendo un sistema de economía circular.",
        tag: "react react-native git html javascript android",
    },
    {
        title: "Portfolio Kinder",
        href: "https://github.com/AndreaKinder/porfolio-kinder",
        description:
            "Portfolio y CV interactivo 3D/2D con el Huevo-K central y blog editorial, creado con Astro 5, Three.js y sistema de diseño Material 3.",
        tag: "astro git bootstrap html javascript",
    },
    {
        title: "Wowfinder",
        href: "https://github.com/edurne85/wowfinder",
        description:
            "Paquete de utilidades para la campaña 'Wowfinder' (campaña de rol basada en el sistema Pathfinder 1ed y ambientada en el universo Warcraft de Blizzard).",
        tag: "react git html javascript",
    },
    {
        title: "Kinder.Vim",
        description:
            "Configuración modular personalizada de Neovim enfocada en velocidad, LSP e integración con terminal en Linux.",
        href: "https://github.com/AndreaKinder/Kinder.Vim",
        tag: "linux bash git nvim",
    },
    {
        title: "Copilot CLI Neovim",
        description:
            "Plugin de Neovim que integra GitHub Copilot CLI para generar y ejecutar comandos de terminal directamente desde el editor.",
        href: "https://github.com/AndreaKinder/copilot-cli.nvim",
        tag: "linux bash git nvim",
    },
    {
        title: "Kinder.Dots",
        description:
            "Colección personal de dotfiles diseñados para crear un entorno de desarrollo y escritorio en Linux cohesivo y productivo.",
        href: "https://github.com/AndreaKinder/Kinder.Dots",
        tag: "linux bash git",
    },
    {
        title: "Kinder.Shell",
        description:
            "Configuraciones modernas y unificadas de shell para Fish, Bash y Zsh, diseñadas para flujos de desarrollo profesional.",
        href: "https://github.com/AndreaKinder/Kinder.Shell",
        tag: "linux bash git",
    },
    {
        title: "RomsManager",
        description:
            "Gestor de ROMs en Linux/Bash para organizar y administrar colecciones de juegos retro de forma automatizada.",
        href: "https://github.com/AndreaKinder/RomsManager",
        tag: "linux bash git",
    },
];
---

<section>
    <div class="mb-4">
        <p class="section-label">Proyectos</p>
        <h2 class="mb-2">Aplicaciones y código abierto</h2>
        <p class="section-desc">
            Selección de aplicaciones web, móviles, proyectos de hackathons y herramientas para entornos Linux y Neovim.
        </p>
    </div>

    <div class="filter-chips mb-4" role="group" aria-label="Filtrar proyectos por tecnología">
        <button class="filter-chip active-chip" data-filter="all">Todos</button>
        <button class="filter-chip" data-filter="linux">Linux</button>
        <button class="filter-chip" data-filter="bash">Bash</button>
        <button class="filter-chip" data-filter="react">React</button>
        <button class="filter-chip" data-filter="react-native">React Native</button>
        <button class="filter-chip" data-filter="git">Git</button>
        <button class="filter-chip" data-filter="html">HTML & CSS</button>
        <button class="filter-chip" data-filter="api">APIs REST</button>
        <button class="filter-chip" data-filter="javascript">JavaScript</button>
        <button class="filter-chip" data-filter="astro">Astro</button>
        <button class="filter-chip" data-filter="bootstrap">Bootstrap</button>
        <button class="filter-chip" data-filter="android">Android</button>
        <button class="filter-chip" data-filter="nvim">Neovim</button>
    </div>

    <div class="project-grid">
        {
            projects.map((project) => (
                <ProjectCard
                    title={project.title}
                    href={project.href}
                    description={project.description}
                    tag={project.tag}
                />
            ))
        }
    </div>
</section>

<script is:inline>
    (function() {
        const chips = document.querySelectorAll('.filter-chip');
        const cards = document.querySelectorAll('.project-card');
        if (!chips.length || !cards.length) return;

        chips.forEach(function(chip) {
            chip.addEventListener('click', function() {
                var filter = this.dataset.filter;

                chips.forEach(function(c) { c.classList.remove('active-chip'); });
                this.classList.add('active-chip');

                cards.forEach(function(card) {
                    var tags = card.dataset.tags || '';
                    card.classList.remove('visible');
                    if (filter === 'all' || tags.split(' ').indexOf(filter) !== -1) {
                        card.classList.add('visible');
                    }
                });
            });
        });
    })();
</script>
