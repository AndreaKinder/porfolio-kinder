---
// Se renderiza en el <head>: aplica el tema (claro/oscuro) y el modo de vista (2d/3d)
// antes del primer pintado para evitar el flash (FOUC).
// Valores por defecto: theme = 'light', view = '2d'.
---

<script is:inline>
    (function () {
        var params = new URLSearchParams(location.search);

        // Tema: ?theme=light|dark o localStorage('theme')
        var paramTheme = params.get('theme');
        var storedTheme = localStorage.getItem('theme');
        var theme =
            paramTheme === 'light' || paramTheme === 'dark'
                ? paramTheme
                : storedTheme === 'light' || storedTheme === 'dark'
                  ? storedTheme
                  : 'light';
        document.documentElement.dataset.theme = theme;

        // Vista 3D deshabilitada temporalmente: forzar siempre vista 2D
        document.documentElement.dataset.view = '2d';
    })();
</script>
