---
import Footer from "../components/footer.astro";
import "../styles/styles.css";
import HeaderMenu from "../components/headerMenu.astro";
import ThemeInit from "../components/themeInit.astro";
const { frontmatter } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <ThemeInit />
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content="Astro" />
        <meta name="theme-color" content="#191115" />
        <title>{frontmatter.title} — Andrea Villar</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
            rel="stylesheet"
        />

        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
            crossorigin="anonymous"
        />
        <style>
            body {
                font-family: var(--font-body);
                background: var(--md-sys-color-surface);
                color: var(--md-sys-color-on-surface);
                margin: 0;
                padding: 0;
            }

            h1 {
                font-family: var(--font-display);
                font-size: clamp(2rem, 4.5vw, 3.25rem);
                font-weight: 700;
                letter-spacing: -0.025em;
                line-height: 1.15;
                color: var(--md-sys-color-on-surface);
                margin-bottom: 1.25rem;
            }

            main {
                font-size: 1rem;
                line-height: 1.75;
                color: var(--md-sys-color-on-surface);
                max-width: var(--content-width);
                margin: 0 auto;
                padding: var(--space-md) 0;
            }

            main :global(h2) {
                font-family: var(--font-display);
                font-size: 1.65rem;
                font-weight: 700;
                letter-spacing: -0.02em;
                color: var(--md-sys-color-on-surface);
                margin-top: 2.5rem;
                margin-bottom: 1rem;
            }

            main :global(h3) {
                font-family: var(--font-body);
                font-size: 1.25rem;
                font-weight: 600;
                color: var(--md-sys-color-on-surface);
                margin-top: 1.75rem;
                margin-bottom: 0.75rem;
            }

            main :global(p) {
                font-size: 1rem;
                line-height: 1.75;
                color: var(--md-sys-color-on-surface-variant);
                margin-bottom: 1.25rem;
                max-width: 70ch;
            }

            main :global(strong) {
                color: var(--md-sys-color-on-surface);
                font-weight: 600;
            }

            main :global(a) {
                color: var(--md-sys-color-primary);
                text-decoration: underline;
                text-underline-offset: 2px;
            }

            main :global(ul),
            main :global(ol) {
                color: var(--md-sys-color-on-surface-variant);
                margin-bottom: 1.5rem;
                padding-left: 1.5rem;
                max-width: 70ch;
            }

            main :global(li) {
                margin-bottom: 0.5rem;
                line-height: 1.7;
            }

            main :global(code) {
                font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                font-size: 0.875em;
                background: var(--md-sys-color-surface-container);
                border: 1px solid var(--md-sys-color-outline-variant);
                border-radius: var(--md-sys-shape-corner-extra-small);
                padding: 0.15em 0.4em;
                color: var(--md-sys-color-primary);
            }

            main :global(pre) {
                background: var(--md-sys-color-surface-container-low) !important;
                border: 1px solid var(--md-sys-color-outline-variant);
                border-radius: var(--md-sys-shape-corner-medium);
                padding: 1.25rem;
                margin-bottom: 1.5rem;
                overflow-x: auto;
            }

            main :global(pre code) {
                background: transparent;
                border: none;
                padding: 0;
                color: inherit;
                font-size: 0.875rem;
            }

            main :global(table) {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 2rem;
                font-size: 0.9375rem;
                background: var(--md-sys-color-surface-container-low);
                border: 1px solid var(--md-sys-color-outline-variant);
                border-radius: var(--md-sys-shape-corner-medium);
                overflow: hidden;
            }

            main :global(th),
            main :global(td) {
                padding: 0.75rem 1rem;
                border-bottom: 1px solid var(--md-sys-color-outline-variant);
                text-align: left;
            }

            main :global(th) {
                font-family: var(--font-body);
                font-size: 0.8125rem;
                font-weight: 600;
                color: var(--md-sys-color-on-surface);
                background: var(--md-sys-color-surface-container);
            }

            main :global(td) {
                color: var(--md-sys-color-on-surface-variant);
            }

            .blog-meta {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                font-family: var(--font-body);
                font-size: 0.875rem;
                color: var(--md-sys-color-on-surface-variant);
                margin-bottom: 1.5rem;
                padding-bottom: 1.5rem;
                border-bottom: 1px solid var(--md-sys-color-outline-variant);
            }

            .blog-meta span {
                font-weight: 600;
                color: var(--md-sys-color-primary);
            }

            @media (max-width: 768px) {
                h1 {
                    font-size: 1.85rem;
                }
            }
        </style>
    </head>
    <body>
        <HeaderMenu />
        <div class="container-narrow" style="padding-top: 5.5rem;">
            <h1>{frontmatter.title}</h1>
            <div class="blog-meta">
                <span>Autora:</span>
                {frontmatter.author}
            </div>
            <main>
                <slot />
            </main>
        </div>
        <div class="container-narrow my-5">
            <a href="/galery-blog" class="btn-secondary">Volver al blog</a>
        </div>
        <Footer />
        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    </body>
</html>
