---
import Footer from "../components/footer.astro";
import "../styles/styles.css";
import HeaderMenu from "../components/headerMenu.astro";
import ThemeInit from "../components/themeInit.astro";
const posts = await Astro.glob("./blog/*.md");
---

<html lang="es">
    <head>
        <ThemeInit />
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#201626" />
        <title>Blog — Andrea Villar</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
            rel="stylesheet"
        />

        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
            crossorigin="anonymous"
        />
    </head>

    <body>
        <HeaderMenu />
        <div class="section">
            <div class="container-narrow">
                <div class="text-center mb-5">
                    <p class="section-label"><span class="label-index">01</span> / Blog</p>
                    <h2 class="mb-3">Articulos y reflexiones</h2>
                    <p class="section-desc">
                        Pensamientos sobre desarrollo, tecnologia y software libre.
                    </p>
                </div>

                <div style="display: flex; flex-direction: column; gap: var(--space-md);">
                    {
                        posts.map((post) => (
                            <div class="blog-card">
                                <div class="row align-items-center g-3 g-md-4">
                                    <div class="col-12 col-md-8">
                                        <h3 class="blog-card-title">
                                            {post.frontmatter.title}
                                        </h3>
                                        <p class="blog-card-desc">
                                            {post.frontmatter.description}
                                        </p>
                                    </div>
                                    <div class="col-12 col-md-4 text-md-end">
                                        <a
                                            href={post.url}
                                            class="blog-link-btn"
                                        >
                                            Leer articulo
                                        </a>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>

                <div class="text-center mt-5">
                    <a href="/" class="blog-link-btn">Volver al inicio</a>
                </div>
            </div>
        </div>
        <Footer />
        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    </body>
</html>
