---
import "../styles/styles.css";
import HeaderMenu from "../components/headerMenu.astro";
import Skills from "../components/skills.astro";
import Footer from "../components/footer.astro";
import Contact from "../components/contact.astro";
import EggScene from "../components/egg-scene.astro";
import ThemeInit from "../components/themeInit.astro";
---

<html lang="es">
    <head>
        <ThemeInit />
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#201626" />
        <meta
            name="description"
            content="Portfolio de Andrea Villar — Desarrolladora de Software."
        />
        <title>Andrea Villar — Desarrolladora de Software</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
            rel="stylesheet"
        />

        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
            crossorigin="anonymous"
        />
    </head>
    <body>
        <HeaderMenu />
        <main>
            <section class="section">
                <div class="container-wide">
                    <div class="hero-stage">
                        <div class="hero-copy">
                            <p class="hero-eyebrow">
                                <span>01</span> / Desarrolladora de Software
                            </p>
                            <h1 class="hero-name">
                                Andrea<br /><em>Villar</em>
                            </h1>
                            <p class="hero-description">
                                Apasionada por el desarrollo web y el software
                                libre. Especializada en crear soluciones
                                digitales innovadoras para el sector sanitario
                                en Goalmed, y desarrollando proyectos
                                personalizados como freelancer. Entusiasta de
                                Linux y Neovim. Basada en Barcelona.
                            </p>
                        </div>
                        <EggScene />
                    </div>
                </div>
            </section>

            <section id="projects" class="section">
                <div class="container-wide">
                    <Skills />
                </div>
            </section>

            <section id="contact" class="section">
                <div class="container-narrow">
                    <Contact />
                </div>
            </section>
        </main>

        <Footer />

        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    </body>
</html>
