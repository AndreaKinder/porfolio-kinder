---
import "../styles/styles.css";
import HeaderMenu from "../components/headerMenu.astro";
import Skills from "../components/skills.astro";
import Footer from "../components/footer.astro";
import Contact from "../components/contact.astro";
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Andrea Villar — Desarrolladora de Software</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
            rel="stylesheet"
        />

        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
            crossorigin="anonymous"
        />
    </head>
    <body>
        <HeaderMenu />
        <main>
            <section class="section" style="padding-top: 7rem;">
                <div class="container-wide">
                    <div class="hero-container p-4 p-md-5">
                        <div class="row align-items-center g-4 g-md-5">
                            <div
                                class="col-12 col-md-5 text-center"
                            >
                                <img
                                    class="profile-image mx-auto"
                                    src="/img/profile-img.png"
                                    alt="Andrea Villar"
                                    width="200"
                                    height="200"
                                />
                            </div>
                            <div class="col-12 col-md-7">
                                <p class="hero-subtitle">Desarrolladora de Software</p>
                                <h1 class="hero-title mb-2">
                                    Andrea<br />Villar
                                </h1>
                                <p class="hero-bio mt-3">
                                    Apasionada por el desarrollo web y el software
                                    libre. Especializada en crear soluciones
                                    digitales innovadoras para el sector sanitario
                                    en Goalmed, y desarrollando proyectos
                                    personalizados como freelancer. Entusiasta de
                                    Linux y Neovim. Basada en Barcelona.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <hr class="section-divider" />

            <section id="projects" class="section">
                <div class="container-wide">
                    <Skills />
                </div>
            </section>

            <hr class="section-divider" />

            <section id="contact" class="section">
                <div class="container-narrow">
                    <Contact />
                </div>
            </section>
        </main>

        <Footer />

        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    </body>
</html>
