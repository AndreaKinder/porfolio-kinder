---
import "../styles/styles.css";
import HeaderMenu from "../components/headerMenu.astro";
import Skills from "../components/skills.astro";
import Footer from "../components/footer.astro";
import Contact from "../components/contact.astro";
// import EggScene from "../components/egg-scene.astro"; // Deshabilitado temporalmente
import ThemeInit from "../components/themeInit.astro";
import LogoMark from "../components/LogoMark.astro";
import { cvPersonalInfo, cvStations } from "../data/cvData";

const inicioStation = cvStations.find((s) => s.id === "inicio");
const sobreMiStation = cvStations.find((s) => s.id === "sobre-mi");
const experienceStation = cvStations.find((s) => s.id === "experiencia");
const skillsStation = cvStations.find((s) => s.id === "habilidades");
const educationStation = cvStations.find((s) => s.id === "educacion");

interface BlogPostModule {
    url?: string;
    frontmatter?: {
        title?: string;
        author?: string;
        date?: string;
        description?: string;
    };
}
const blogPosts = Object.values(
    import.meta.glob<BlogPostModule>("./blog/*.md", { eager: true }),
).sort((a, b) => {
    const da = a.frontmatter?.date ? Date.parse(a.frontmatter.date) : 0;
    const db = b.frontmatter?.date ? Date.parse(b.frontmatter.date) : 0;
    return db - da;
});
---

<!doctype html>
<html lang="es">
    <head>
        <ThemeInit />
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#f7f7f5" />
        <meta
            name="description"
            content="Portfolio profesional de Andrea Villar Torres — AndreaKinder Software Development (Full Stack Web & Mobile)."
        />
        <title>AndreaKinder — Software Development · Andrea Villar Torres</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
            rel="stylesheet"
        />

        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
            crossorigin="anonymous"
        />
    </head>
    <body>
        <HeaderMenu />

        {/* Vista 3D deshabilitada temporalmente
        <EggScene />
        */}

        <!-- =========================================================
             MODO VISTA 2D: Web Portfolio + CV con Sistema Material Design 3
             ========================================================= -->
        <div id="cv-2d-view" class="cv-2d-wrapper">
            <main>
                <!-- INICIO -->
                <section id="inicio" class="section cv-2d-hero-section">
                    <div class="container-wide">
                        <div class="corp-hero-grid">
                            <div class="corp-hero-editorial">
                                <h1 class="hero-name">Andrea Villar Torres</h1>
                                <p class="hero-role">Desarrolladora Full Stack · Web, Mobile &amp; Cloud</p>
                                <p class="hero-description">
                                    {inicioStation?.summary}
                                </p>

                                <div class="corp-hero-actions">
                                    <a href={cvPersonalInfo.emailHref} class="btn-primary">
                                        Enviar correo
                                    </a>
                                    <a
                                        href="/CV_Andrea_Villar_Torres.pdf"
                                        download="CV_Andrea_Villar_Torres.pdf"
                                        class="btn-secondary"
                                    >
                                        Descargar CV ↓
                                    </a>
                                    <a href="#projects" class="btn-ghost">
                                        Ver proyectos
                                    </a>
                                    <div class="corp-hero-social">
                                        <a
                                            href={cvPersonalInfo.github}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            GitHub ↗
                                        </a>
                                        <a
                                            href={cvPersonalInfo.linkedin}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            LinkedIn ↗
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <div class="corp-hero-logo" aria-hidden="true">
                                <LogoMark size={240} />
                            </div>
                        </div>

                        <div class="corp-metrics-bar">
                            <div class="corp-metric-item">
                                <span class="corp-metric-value">{cvPersonalInfo.yearsExperience}+</span>
                                <span class="corp-metric-label">Experiencia en producción desarrollando producto end-to-end</span>
                            </div>
                            <div class="corp-metric-item">
                                <span class="corp-metric-value">Web &amp; Mobile</span>
                                <span class="corp-metric-label">Aplicaciones multiplataforma e interfaces reactivas de alto rendimiento</span>
                            </div>
                            <div class="corp-metric-item">
                                <span class="corp-metric-value">Cloud &amp; Linux</span>
                                <span class="corp-metric-label">Despliegues reproducibles con Docker, Traefik y Cloudflare R2</span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- SOBRE MÍ (Sección independiente) -->
                <section id="sobre-mi" class="section-sm cv-2d-section">
                    <div class="container-wide">
                        <div class="mb-4">
                            <p class="section-label">01 — Sobre mí</p>
                            <h2 class="mb-2">Trayectoria y enfoque técnico</h2>
                        </div>

                        <div class="m3-about-lead-card mb-4">
                            <p class="m3-about-summary mb-3">
                                {cvPersonalInfo.summary}
                            </p>
                            <div class="d-flex flex-wrap gap-2">
                                <span class="m3-chip">{cvPersonalInfo.yearsExperience} de experiencia</span>
                                <span class="m3-chip">Sector: {cvPersonalInfo.industry}</span>
                                <span class="m3-chip">Disponibilidad para viajar: {cvPersonalInfo.willingToTravel}</span>
                            </div>
                        </div>

                        <div class="row g-4">
                            {
                                sobreMiStation?.items.map((item) => (
                                    <div class="col-12 col-md-4">
                                        <article class="cv-2d-card h-100">
                                            <h3 class="cv-2d-card-title mb-1">{item.title}</h3>
                                            {item.subtitle && <p class="cv-detail-subtitle">{item.subtitle}</p>}
                                            <p class="cv-2d-card-desc">{item.description}</p>
                                            <div class="cv-detail-tags mt-auto">
                                                {item.tags.map((tag) => (
                                                    <span class="m3-chip">{tag}</span>
                                                ))}
                                            </div>
                                        </article>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </section>

                <!-- EXPERIENCIA LABORAL -->
                <section id="experiencia" class="section-sm cv-2d-section">
                    <div class="container-wide">
                        <div class="mb-4">
                            <p class="section-label">02 — Experiencia</p>
                            <h2 class="mb-2">Trayectoria profesional</h2>
                            <p class="section-desc">
                                Desarrollo Full Stack en producción combinando interfaces web y mobile con servicios backend e infraestructura contenerizada.
                            </p>
                        </div>

                        {
                            experienceStation && (
                                <div class="cv-exp-banner mb-4">
                                    <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2">
                                        <div>
                                            <h3 class="cv-exp-role">{experienceStation.organization}</h3>
                                            <p class="cv-exp-company mb-0">
                                                <strong>GoalmedGroup</strong> · {experienceStation.location}
                                            </p>
                                        </div>
                                        <span class="cv-period-badge">{experienceStation.period}</span>
                                    </div>
                                    <p class="mt-3 mb-0">{experienceStation.summary}</p>
                                </div>
                            )
                        }

                        <div class="row g-4">
                            {
                                experienceStation?.items.map((item) => (
                                    <div class="col-12 col-md-6">
                                        <article class="cv-2d-card h-100">
                                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                                <h4 class="cv-2d-card-title">{item.title}</h4>
                                                {item.period && <span class="cv-detail-period">{item.period}</span>}
                                            </div>
                                            {item.subtitle && <p class="cv-detail-subtitle">{item.subtitle}</p>}
                                            <p class="cv-2d-card-desc">{item.description}</p>
                                            <div class="cv-detail-tags mt-auto">
                                                {item.tags.map((tag) => (
                                                    <span class="m3-chip">{tag}</span>
                                                ))}
                                            </div>
                                        </article>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </section>

                <!-- PROYECTOS DESTACADOS (3 ÚLTIMOS + GALERÍA COMPLETA) -->
                <section id="projects" class="section-sm cv-2d-section">
                    <div class="container-wide">
                        <Skills limit={3} />
                    </div>
                </section>

                <!-- HABILIDADES Y TECNOLOGÍAS -->
                <section id="habilidades" class="section-sm cv-2d-section">
                    <div class="container-wide">
                        <div class="mb-4">
                            <p class="section-label">04 — Stack técnico</p>
                            <h2 class="mb-2">Stack y competencias</h2>
                            <p class="section-desc">
                                Tecnologías y competencias organizativas aplicadas en el ciclo completo de desarrollo de software.
                            </p>
                        </div>

                        <div class="row g-4 mb-4">
                            {
                                skillsStation?.items.map((item) => (
                                    <div class="col-12 col-md-6">
                                        <article class="cv-2d-card h-100">
                                            <h3 class="cv-2d-card-title mb-1">{item.title}</h3>
                                            {item.subtitle && <p class="cv-detail-subtitle">{item.subtitle}</p>}
                                            <p class="cv-2d-card-desc">{item.description}</p>
                                            <div class="cv-detail-tags mt-auto">
                                                {item.tags.map((tag) => (
                                                    <span class="m3-chip">{tag}</span>
                                                ))}
                                            </div>
                                        </article>
                                    </div>
                                ))
                            }
                        </div>

                        <div class="cv-all-skills-box">
                            <p class="cv-subnodes-label mb-3">Competencias del CV</p>
                            <div class="d-flex flex-wrap gap-2">
                                {
                                    cvPersonalInfo.allSkills.map((skill) => (
                                        <span class="m3-chip">{skill}</span>
                                    ))
                                }
                            </div>
                        </div>
                    </div>
                </section>

                <!-- EDUCACIÓN Y FORMACIÓN -->
                <section id="educacion" class="section-sm cv-2d-section">
                    <div class="container-wide">
                        <div class="mb-4">
                            <p class="section-label">05 — Formación</p>
                            <h2 class="mb-2">Formación académica</h2>
                            <p class="section-desc">
                                Base científica y técnica en Química aplicada al rigor analítico, automatización y arquitectura de software.
                            </p>
                        </div>

                        <div class="row g-4">
                            {
                                educationStation?.items.map((item) => (
                                    <div class="col-12 col-md-4">
                                        <article class="cv-2d-card h-100">
                                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                                <h3 class="cv-2d-card-title">{item.title}</h3>
                                            </div>
                                            {item.period && (
                                                <p class="cv-period-badge d-inline-block mb-2">{item.period}</p>
                                            )}
                                            {item.subtitle && <p class="cv-detail-subtitle">{item.subtitle}</p>}
                                            <p class="cv-2d-card-desc">{item.description}</p>
                                            <div class="cv-detail-tags mt-auto">
                                                {item.tags.map((tag) => (
                                                    <span class="m3-chip">{tag}</span>
                                                ))}
                                            </div>
                                        </article>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </section>

                <!-- BLOG & PUBLICACIONES -->
                <section id="blog" class="section-sm cv-2d-section">
                    <div class="container-wide">
                        <div class="mb-4">
                            <p class="section-label">06 — Publicaciones</p>
                            <h2 class="mb-2">Artículos y reflexiones</h2>
                            <p class="section-desc">
                                Artículos técnicos sobre inteligencia artificial, protocolos web emergentes y crónicas de hackathons.
                            </p>
                        </div>

                        <div class="row g-4 mb-4">
                            {
                                blogPosts.map((post) => (
                                    <div class="col-12 col-md-6">
                                        <a href={post.url} class="text-decoration-none d-block h-100">
                                            <article class="blog-card h-100 d-flex flex-column">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="cv-period-badge">
                                                        {post.frontmatter?.date ?? "Artículo"}
                                                    </span>
                                                    <span class="cv-detail-period">Por {post.frontmatter?.author ?? "Andrea Villar"}</span>
                                                </div>
                                                <h3 class="blog-card-title">{post.frontmatter?.title}</h3>
                                                <p class="blog-card-desc mb-3">{post.frontmatter?.description}</p>
                                                <span class="project-card-link mt-auto">
                                                    Leer artículo →
                                                </span>
                                            </article>
                                        </a>
                                    </div>
                                ))
                            }
                        </div>

                        <div>
                            <a href="/galery-blog" class="btn-secondary">
                                Ver todos los artículos del blog
                            </a>
                        </div>
                    </div>
                </section>

                <!-- CONTACTO -->
                <section id="contact" class="section-sm cv-2d-section">
                    <div class="container-narrow">
                        <Contact />
                    </div>
                </section>
            </main>

            <Footer />
        </div>

        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>

        <style is:global>
            /* =====================================================
               CONMUTACIÓN ENTRE VISTA 3D Y VISTA 2D
               ===================================================== */
            #cv-print-sheet {
                display: none;
            }

            html[data-view="3d"],
            html[data-view="3d"] body {
                overflow: hidden;
                height: 100svh;
            }

            html[data-view="3d"] #cv-2d-view {
                display: none !important;
            }

            html[data-view="3d"] #cv-3d-view {
                display: block !important;
            }

            html[data-view="2d"],
            html[data-view="2d"] body {
                overflow-x: hidden;
                overflow-y: auto;
                height: auto;
            }

            html[data-view="2d"] #cv-3d-view {
                display: none !important;
            }

            html[data-view="2d"] #cv-2d-view {
                display: block !important;
            }

            /* =====================================================
               ESTILOS DEL ESCENARIO 3D (MATERIAL DESIGN 3 SURFACES)
               ===================================================== */
            .cv-3d-stage {
                position: relative;
                width: 100vw;
                height: 100svh;
                overflow: hidden;
                user-select: none;
            }

            .cv-canvas-mount {
                position: fixed;
                inset: 0;
                z-index: 1;
                cursor: grab;
            }

            .cv-canvas-mount:active {
                cursor: grabbing;
            }

            .cv-canvas-mount canvas {
                display: block;
                width: 100%;
                height: 100%;
                outline: none;
            }

            /* M3 Surface Container High HUD Panel */
            .cv-hud-panel {
                position: absolute;
                top: 68px;
                left: 2.5%;
                z-index: 10;
                width: min(440px, 92vw);
                max-height: calc(100svh - 132px);
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
                padding: 1.25rem;
                background-color: color-mix(
                    in srgb,
                    var(--md-sys-color-surface-container) 92%,
                    transparent
                );
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border: 1px solid var(--md-sys-color-outline-variant);
                border-radius: var(--md-sys-shape-corner-large);
                box-shadow: var(--md-sys-elevation-2);
                overflow-y: auto;
                user-select: text;
                transition:
                    transform var(--duration-normal) var(--ease-out),
                    opacity var(--duration-normal) var(--ease-out);
            }

            .cv-hud-panel.cv-panel-minimized {
                transform: translateX(-112%);
                opacity: 0;
                pointer-events: none;
            }

            .cv-panel-top-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.5rem;
                flex-wrap: wrap;
            }

            .cv-station-title {
                font-family: var(--font-display);
                font-size: clamp(1.5rem, 2.4vw, 2rem);
                font-weight: 700;
                line-height: 1.15;
                margin: 0.15rem 0 0;
                color: var(--md-sys-color-on-surface);
            }

            .cv-period-badge {
                display: inline-flex;
                align-items: center;
                height: 26px;
                padding: 0 0.65rem;
                font-family: var(--font-body);
                font-size: 0.75rem;
                font-weight: 600;
                color: var(--md-sys-color-on-secondary-container);
                background-color: var(--md-sys-color-secondary-container);
                border-radius: var(--md-sys-shape-corner-small);
                white-space: nowrap;
            }

            .cv-org-line {
                font-size: 0.875rem;
                font-weight: 600;
                color: var(--md-sys-color-primary);
                margin: 0.25rem 0 0.4rem;
            }

            .cv-org-line span {
                font-weight: 400;
                color: var(--md-sys-color-on-surface-variant);
            }

            .cv-station-summary {
                font-size: 0.875rem;
                line-height: 1.6;
                color: var(--md-sys-color-on-surface-variant);
                margin: 0;
            }

            .cv-subnodes-bar {
                border-top: 1px solid var(--md-sys-color-outline-variant);
                padding-top: 0.75rem;
            }

            .cv-subnodes-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 0.5rem;
            }

            .cv-subnodes-label {
                font-family: var(--font-body);
                font-size: 0.8125rem;
                font-weight: 600;
                color: var(--md-sys-color-on-surface-variant);
            }

            .cv-subnodes-arrows {
                display: flex;
                align-items: center;
                gap: 0.35rem;
            }

            .cv-item-counter {
                font-family: var(--font-body);
                font-size: 0.8125rem;
                font-weight: 600;
                color: var(--md-sys-color-on-surface-variant);
            }

            .cv-mini-btn {
                width: 28px;
                height: 28px;
                display: inline-grid;
                place-items: center;
                font-size: 11px;
                background-color: var(--md-sys-color-surface-container-high);
                color: var(--md-sys-color-on-surface);
                border: 1px solid var(--md-sys-color-outline-variant);
                border-radius: var(--md-sys-shape-corner-small);
                cursor: pointer;
                transition: background-color var(--duration-fast) var(--ease-out);
            }

            .cv-mini-btn:hover {
                background-color: var(--md-sys-color-surface-container-highest);
            }

            .cv-subnode-chips {
                display: flex;
                flex-wrap: wrap;
                gap: 0.375rem;
            }

            .cv-subnode-chip {
                font-family: var(--font-body);
                font-size: 0.8125rem;
                font-weight: 500;
                height: 30px;
                padding: 0 0.75rem;
                background-color: transparent;
                color: var(--md-sys-color-on-surface-variant);
                border: 1px solid var(--md-sys-color-outline-variant);
                border-radius: var(--md-sys-shape-corner-small);
                cursor: pointer;
                transition:
                    background-color var(--duration-fast) var(--ease-out),
                    color var(--duration-fast) var(--ease-out);
            }

            .cv-subnode-chip:hover {
                background-color: color-mix(in srgb, var(--md-sys-color-on-surface) 8%, transparent);
                color: var(--md-sys-color-on-surface);
            }

            .cv-subnode-chip.active {
                background-color: var(--md-sys-color-secondary-container);
                color: var(--md-sys-color-on-secondary-container);
                border-color: transparent;
                font-weight: 600;
            }

            .cv-detail-card {
                background-color: var(--md-sys-color-surface-container-low);
                border: 1px solid var(--md-sys-color-outline-variant);
                border-radius: var(--md-sys-shape-corner-medium);
                padding: 1rem;
            }

            .cv-detail-title {
                font-family: var(--font-display);
                font-size: 1.05rem;
                font-weight: 600;
                margin: 0;
                color: var(--md-sys-color-on-surface);
            }

            .cv-detail-subtitle {
                font-size: 0.8125rem;
                font-weight: 500;
                color: var(--md-sys-color-primary);
                margin: 0.15rem 0 0.5rem;
            }

            .cv-detail-period {
                font-family: var(--font-body);
                font-size: 0.75rem;
                font-weight: 500;
                color: var(--md-sys-color-on-surface-variant);
                white-space: nowrap;
            }

            .cv-detail-desc {
                font-size: 0.875rem;
                line-height: 1.6;
                color: var(--md-sys-color-on-surface-variant);
                margin-bottom: 0.75rem;
            }

            .cv-detail-footer {
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 0.5rem;
            }

            .cv-detail-tags {
                display: flex;
                flex-wrap: wrap;
                gap: 0.375rem;
            }

            .cv-tag-badge {
                display: inline-flex;
                align-items: center;
                height: 26px;
                padding: 0 0.6rem;
                font-family: var(--font-body);
                font-size: 0.75rem;
                font-weight: 500;
                color: var(--md-sys-color-on-surface-variant);
                background-color: var(--md-sys-color-surface-container-high);
                border-radius: var(--md-sys-shape-corner-small);
            }

            .cv-detail-link {
                font-family: var(--font-body);
                font-size: 0.8125rem;
                font-weight: 600;
                color: var(--md-sys-color-on-primary);
                background-color: var(--md-sys-color-primary);
                height: 32px;
                padding: 0 0.9rem;
                border-radius: var(--md-sys-shape-corner-full);
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
            }

            .cv-detail-link:hover {
                text-decoration: none;
                background-color: color-mix(
                    in srgb,
                    var(--md-sys-color-primary) 90%,
                    var(--md-sys-color-on-primary) 10%
                );
                color: var(--md-sys-color-on-primary);
            }

            .cv-hover-tooltip {
                position: fixed;
                z-index: 30;
                pointer-events: none;
                font-family: var(--font-body);
                font-size: 0.8125rem;
                font-weight: 500;
                color: var(--md-sys-color-on-surface);
                background-color: var(--md-sys-color-surface-container-high);
                border: 1px solid var(--md-sys-color-outline-variant);
                padding: 0.35rem 0.75rem;
                border-radius: var(--md-sys-shape-corner-small);
                opacity: 0;
                transition: opacity 120ms ease;
