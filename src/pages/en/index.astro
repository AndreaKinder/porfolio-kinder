---
import "../../styles/styles.css";
import HeaderMenu from "../../components/headerMenu.astro";
import Skills from "../../components/skills.astro";
import Footer from "../../components/footer.astro";
import Contact from "../../components/contact.astro";
import ThemeInit from "../../components/themeInit.astro";
import LogoMark from "../../components/LogoMark.astro";
import { cvPersonalInfo } from "../../data/cvData";
import { cvEn } from "../../data/cvDataEn";

interface BlogPostModule {
    url?: string;
    frontmatter?: {
        title?: string;
        author?: string;
        date?: string;
        description?: string;
    };
}
const blogPosts = Object.values(
    import.meta.glob<BlogPostModule>("../blog/*.md", { eager: true }),
).sort((a, b) => {
    const da = a.frontmatter?.date ? Date.parse(a.frontmatter.date) : 0;
    const db = b.frontmatter?.date ? Date.parse(b.frontmatter.date) : 0;
    return db - da;
});
---

<!doctype html>
<html lang="en">
    <head>
        <ThemeInit />
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#f7f7f5" />
        <meta
            name="description"
            content="Professional portfolio of Andrea Villar Torres — AndreaKinder Software Development (Full Stack Web & Mobile)."
        />
        <title>AndreaKinder — Software Development · Andrea Villar Torres</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
            rel="stylesheet"
        />

        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
            crossorigin="anonymous"
        />
    </head>
    <body>
        <HeaderMenu lang="en" />

        <div id="cv-2d-view" class="cv-2d-wrapper">
            <main>
                <!-- HOME -->
                <section id="inicio" class="section cv-2d-hero-section">
                    <div class="container-wide">
                        <div class="corp-hero-grid">
                            <div class="corp-hero-editorial">
                                <span class="corp-status-pill">
                                    <span class="corp-status-dot" aria-hidden="true"></span>
                                    {cvEn.availability}
                                </span>
                                <h1 class="hero-name">Andrea Villar Torres</h1>
                                <p class="hero-role">{cvEn.role}</p>
                                <p class="hero-description">
                                    {cvEn.heroSummary}
                                </p>

                                <div class="corp-hero-actions">
                                    <a href={cvPersonalInfo.emailHref} class="btn-primary">
                                        Send email
                                    </a>
                                    <a
                                        href="/CV_Andrea_Villar_Torres_EN.pdf"
                                        download="CV_Andrea_Villar_Torres_EN.pdf"
                                        class="btn-secondary"
                                    >
                                        Download CV ↓
                                    </a>
                                    <a href="#projects" class="btn-ghost">
                                        View projects
                                    </a>
                                    <div class="corp-hero-social">
                                        <a
                                            href={cvPersonalInfo.github}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            GitHub ↗
                                        </a>
                                        <a
                                            href={cvPersonalInfo.linkedin}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            LinkedIn ↗
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <div class="corp-hero-logo" aria-hidden="true">
                                <LogoMark size={240} />
                            </div>
                        </div>

                        <div class="corp-metrics-bar">
                            <div class="corp-metric-item">
                                <span class="corp-metric-value">{cvEn.yearsExperience}</span>
                                <span class="corp-metric-label">Production experience delivering end-to-end software products</span>
                            </div>
                            <div class="corp-metric-item">
                                <span class="corp-metric-value">Web &amp; Mobile</span>
                                <span class="corp-metric-label">Cross-platform apps and high-performance reactive interfaces</span>
                            </div>
                            <div class="corp-metric-item">
                                <span class="corp-metric-value">Cloud &amp; Linux</span>
                                <span class="corp-metric-label">Reproducible deployments with Docker, Traefik, and Cloudflare R2</span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ABOUT -->
                <section id="sobre-mi" class="section-sm cv-2d-section">
                    <div class="container-wide">
                        <div class="mb-4">
                            <p class="section-label">01 — About</p>
                            <h2 class="mb-2">Background &amp; technical approach</h2>
                        </div>

                        <div class="m3-about-lead-card mb-4">
                            <p class="m3-about-summary mb-3">
                                {cvEn.aboutSummary}
                            </p>
                            <div class="d-flex flex-wrap gap-2">
                                <span class="m3-chip">{cvEn.yearsExperience} experience</span>
                                <span class="m3-chip">Industry: {cvEn.industry}</span>
                                <span class="m3-chip">Willing to travel: {cvEn.willingToTravel}</span>
                            </div>
                        </div>

                        <div class="row g-4">
                            {
                                cvEn.aboutCards.map((item) => (
                                    <div class="col-12 col-md-4">
                                        <article class="cv-2d-card h-100">
                                            <h3 class="cv-2d-card-title mb-1">{item.title}</h3>
                                            <p class="cv-detail-subtitle">{item.subtitle}</p>
                                            <p class="cv-2d-card-desc">{item.description}</p>
                                            <div class="cv-detail-tags mt-auto">
                                                {item.tags.map((tag) => (
                                                    <span class="m3-chip">{tag}</span>
                                                ))}
                                            </div>
                                        </article>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </section>

                <!-- EXPERIENCE -->
                <section id="experiencia" class="section-sm cv-2d-section">
                    <div class="container-wide">
                        <div class="mb-4">
                            <p class="section-label">02 — Experience</p>
                            <h2 class="mb-2">Professional track record</h2>
                            <p class="section-desc">
                                Production Full Stack engineering combining web and mobile interfaces with backend APIs and containerized infrastructure.
                            </p>
                        </div>

                        <div class="cv-exp-banner mb-4">
                            <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2">
                                <div>
                                    <h3 class="cv-exp-role">{cvEn.experienceBanner.role}</h3>
                                    <p class="cv-exp-company mb-0">
                                        <strong>{cvEn.experienceBanner.company}</strong> · {cvEn.experienceBanner.location}
                                    </p>
                                </div>
                                <span class="cv-period-badge">{cvEn.experienceBanner.period}</span>
                            </div>
                            <p class="mt-3 mb-0">{cvEn.experienceBanner.summary}</p>
                        </div>

                        <div class="row g-4">
                            {
                                cvEn.experienceItems.map((item) => (
                                    <div class="col-12 col-md-6">
                                        <article class="cv-2d-card h-100">
                                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                                <h4 class="cv-2d-card-title">{item.title}</h4>
                                                <span class="cv-detail-period">{item.period}</span>
                                            </div>
                                            <p class="cv-detail-subtitle">{item.subtitle}</p>
                                            <p class="cv-2d-card-desc">{item.description}</p>
                                            <div class="cv-detail-tags mt-auto">
                                                {item.tags.map((tag) => (
                                                    <span class="m3-chip">{tag}</span>
                                                ))}
                                            </div>
                                        </article>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </section>

                <!-- PROJECTS -->
                <section id="projects" class="section-sm cv-2d-section">
                    <div class="container-wide">
                        <Skills limit={3} lang="en" />
                    </div>
                </section>

                <!-- STACK & SKILLS -->
                <section id="habilidades" class="section-sm cv-2d-section">
                    <div class="container-wide">
                        <div class="mb-4">
                            <p class="section-label">04 — Tech Stack</p>
                            <h2 class="mb-2">Stack &amp; capabilities</h2>
                            <p class="section-desc">
                                Technologies and organizational competencies applied across the full software development lifecycle.
                            </p>
                        </div>

                        <div class="row g-4 mb-4">
                            {
                                cvEn.skillGroups.map((item) => (
                                    <div class="col-12 col-md-6">
                                        <article class="cv-2d-card h-100">
                                            <h3 class="cv-2d-card-title mb-1">{item.title}</h3>
                                            <p class="cv-detail-subtitle">{item.subtitle}</p>
                                            <p class="cv-2d-card-desc">{item.description}</p>
                                            <div class="cv-detail-tags mt-auto">
                                                {item.tags.map((tag) => (
                                                    <span class="m3-chip">{tag}</span>
                                                ))}
                                            </div>
                                        </article>
                                    </div>
                                ))
                            }
                        </div>

                        <div class="cv-all-skills-box">
                            <p class="cv-subnodes-label mb-3">Core technologies</p>
                            <div class="d-flex flex-wrap gap-2">
                                {
                                    cvPersonalInfo.allSkills.map((skill) => (
                                        <span class="m3-chip">{skill}</span>
                                    ))
                                }
                            </div>
                        </div>
                    </div>
                </section>

                <!-- EDUCATION -->
                <section id="educacion" class="section-sm cv-2d-section">
                    <div class="container-wide">
                        <div class="mb-4">
                            <p class="section-label">05 — Education</p>
                            <h2 class="mb-2">Academic background</h2>
                            <p class="section-desc">
                                Scientific and laboratory foundation applied to analytical rigor, automation, and software architecture.
                            </p>
                        </div>

                        <div class="row g-4">
                            {
                                cvEn.educationItems.map((item) => (
                                    <div class="col-12 col-md-4">
                                        <article class="cv-2d-card h-100">
                                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                                <h3 class="cv-2d-card-title">{item.title}</h3>
                                            </div>
                                            <p class="cv-period-badge d-inline-block mb-2">{item.period}</p>
                                            <p class="cv-detail-subtitle">{item.subtitle}</p>
                                            <p class="cv-2d-card-desc">{item.description}</p>
                                            <div class="cv-detail-tags mt-auto">
                                                {item.tags.map((tag) => (
                                                    <span class="m3-chip">{tag}</span>
                                                ))}
                                            </div>
                                        </article>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </section>

                <!-- BLOG & PUBLICATIONS -->
                <section id="blog" class="section-sm cv-2d-section">
                    <div class="container-wide">
                        <div class="mb-4">
                            <p class="section-label">06 — Publications</p>
                            <h2 class="mb-2">Articles &amp; technical writing</h2>
                            <p class="section-desc">
                                Technical articles on local AI agents, emerging web protocols, and hackathon chronicles (published in Spanish).
                            </p>
                        </div>

                        <div class="row g-4 mb-4">
                            {
                                blogPosts.map((post) => (
                                    <div class="col-12 col-md-6">
                                        <a href={post.url} class="text-decoration-none d-block h-100">
                                            <article class="blog-card h-100 d-flex flex-column">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="cv-period-badge">
                                                        {post.frontmatter?.date ?? "Article"}
                                                    </span>
                                                    <span class="cv-detail-period">By {post.frontmatter?.author ?? "Andrea Villar"}</span>
                                                </div>
                                                <h3 class="blog-card-title">{post.frontmatter?.title}</h3>
                                                <p class="blog-card-desc mb-3">{post.frontmatter?.description}</p>
                                                <span class="project-card-link mt-auto">
                                                    Read article →
                                                </span>
                                            </article>
                                        </a>
                                    </div>
                                ))
                            }
                        </div>

                        <div>
                            <a href="/galery-blog" class="btn-secondary">
                                View all blog articles
                            </a>
                        </div>
                    </div>
                </section>

                <!-- CONTACT -->
                <section id="contact" class="section-sm cv-2d-section">
                    <div class="container-narrow">
                        <Contact lang="en" />
                    </div>
                </section>
            </main>

            <Footer />
        </div>

        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    </body>
</html>
